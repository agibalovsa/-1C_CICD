#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl

// ПрограммныйИнтерфейс

@Глобально
метод Инициализировать(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч КластерV8 = ПолучитьКластер(ПараметрыСоединения)

    ПараметрыСоединения.ПараметрыСоединенияКластера.ИД                = КластерV8.ИдКластера
    ПараметрыСоединения.ПараметрыСоединенияКластера.ПериодПерезапуска = КластерV8.ПериодПерезапускаПроцесса.Секунды

    пер ИнфобазаV8: ИнфобазаV8?
    для ИнфобазаОписаниеV8 из КластерV8.ПолучитьИнфобазы()
        если ИнфобазаОписаниеV8.Имя == ПараметрыСоединения.ПараметрыИБ.Имя
            ИнфобазаV8 = ИнфобазаОписаниеV8.ВыполнитьАутентификацию(ПараметрыСоединения.Логин, ПараметрыСоединения.Пароль)
            прервать
        ;
    ;

    ПараметрыСоединения.ПараметрыИБ.ИД = ИнфобазаV8.ИдИнфобазы

;

@Глобально
метод ЗаблокироватьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)
    
    знч ИнфобазаV8 = ПолучитьИнформационнуюБазу(ПараметрыСоединения)
    ИнфобазаV8.БлокировкаРегламентныхЗаданий = Истина
    ИнфобазаV8.ВключенаБлокировкаНачалаСеансов = Истина
    ИнфобазаV8.КодРазрешенияНачалаСеансов = ПараметрыСоединения.КодРазрешения
    ИнфобазаV8.Записать()

;

@Глобально
метод РазблокироватьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)
    
    знч ИнфобазаV8 = ПолучитьИнформационнуюБазу(ПараметрыСоединения)
    ИнфобазаV8.БлокировкаРегламентныхЗаданий = Ложь
    ИнфобазаV8.ВключенаБлокировкаНачалаСеансов = Ложь
    ИнфобазаV8.Записать()

;

@Глобально
метод ЗавершитьСоединенияИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): Булево

    пер ПодождатьМинуту = Ложь
    пер БылиЗавершения = Ложь
    знч ИнфобазаV8 = ПолучитьИнформационнуюБазу(ПараметрыСоединения)
    для СеансV8 из ИнфобазаV8.ПолучитьСеансы()
        если (не НеБлокирующиеПриложения().Содержит(СеансV8.ИмяПриложения))
            СеансV8.ЗавершитьСеанс()
            ПодождатьМинуту = Истина
            БылиЗавершения  = Истина
        ;
    ;

    если ПодождатьМинуту
        Пауза(1м)
        ПодождатьМинуту = Ложь
    ;

    для СоединениеV8 из ИнфобазаV8.ПолучитьСоединения()
        если (не НеБлокирующиеПриложения().Содержит(СоединениеV8.ИмяПриложения))
            и СоединениеV8.НомерСоединения > 0
            СоединениеV8.Отключить()
            ПодождатьМинуту = Истина
            БылиЗавершения  = Истина
        ;
    ;

    если ПодождатьМинуту
        Пауза(1м)
    ;

    возврат БылиЗавершения

;

@Глобально
метод ПроверитьАктивныеСоединенияИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): Массив<Строка>

    знч АктивныеСоединения = новый Массив<Строка>()

    знч ИнфобазаV8 = ПолучитьИнформационнуюБазу(ПараметрыСоединения)
    для СеансV8 из ИнфобазаV8.ПолучитьСеансы()
        если (не НеБлокирующиеПриложения().Содержит(СеансV8.ИмяПриложения))
            АктивныеСоединения.Добавить("Сеанс %{СеансV8.НомерСеанса} (%{СеансV8.ВремяПоследнейАктивности}): %{СеансV8.ИмяКомпьютера} %{СеансV8.ИмяПользователя}  %{СеансV8.ИмяПриложения}\н")
        ;
    ;

    для СоединениеV8 из ИнфобазаV8.ПолучитьСоединения()
        если (не НеБлокирующиеПриложения().Содержит(СоединениеV8.ИмяПриложения))
            и СоединениеV8.НомерСоединения > 0
            и СоединениеV8.НомерСеанса == 0
            АктивныеСоединения.Добавить("Соединение %{СоединениеV8.НомерСоединения} (%{СоединениеV8.ВремяУстановкиСоединения}): %{СоединениеV8.ИмяКомпьютера} %{СоединениеV8.ИмяПриложения}")
        ;
    ;

    возврат АктивныеСоединения
;

@Глобально
метод ВыполнитьМягкийПерезапускКластера(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч КластерV8 = ПолучитьКластер(ПараметрыСоединения)
    КластерV8.ПериодПерезапускаПроцесса = 30с
    КластерV8.Записать()

    Пауза(5м)

    КластерV8.ПериодПерезапускаПроцесса = новый Длительность(0, 0, ПараметрыСоединения.ПараметрыСоединенияКластера.ПериодПерезапуска)
    КластерV8.Записать()
;

// СлужебныеПроцедурыИФункции

@Локально
метод ПолучитьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ) : ИнфобазаV8

    знч КластерV8 = ПолучитьКластер(ПараметрыСоединения)
    знч ИнфобазаОписаниеV8 = КластерV8.ПолучитьИнфобазу(ПараметрыСоединения.ПараметрыИБ.ИД)
    знч ИнфобазаV8         = ИнфобазаОписаниеV8.ВыполнитьАутентификацию(ПараметрыСоединения.Логин, ПараметрыСоединения.Пароль)
    
    возврат ИнфобазаV8
;

@Локально
метод ПолучитьКластер(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): КластерV8

    знч Сервер = новый АдминистрированиеСервераV8(ПараметрыСоединения.ПараметрыСоединенияКластера.Адрес, ПараметрыСоединения.ПараметрыСоединенияКластера.Порт)
    Сервер.ВыполнитьАутентификацию(ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинСервера, ПараметрыСоединения.ПараметрыСоединенияКластера.ПарольСервера)
    знч КластерV8 = Сервер.ПолучитьКластеры()[0]
    КластерV8.ВыполнитьАутентификацию(ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинКластера, ПараметрыСоединения.ПараметрыСоединенияКластера.ПарольКластера)

    возврат КластерV8

;

@Локально
метод НеБлокирующиеПриложения() : Множество<Строка>

    возврат{ "SrvrConsole", "JobScheduler", "RAS" }

;