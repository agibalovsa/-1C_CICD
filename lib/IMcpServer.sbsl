#!/usr/bin/executor

#требуется IMcpServerProperties.sbsl
#требуется IProjectProperties.sbsl
#требуется ILogging.sbsl

@Глобально
структура McpServer

    пер McpServerInfo:                 IMcpServerProperties.Info
    пер McpCapabilities:               IMcpServerProperties.McpCapabilities
    пер ToolsList:                     IMcpServerProperties.ToolsList
    пер ПараметрыЗаписиОтветаJSON:     НастройкиЗаписиОбъектовJson
    пер ВыполнитьСкрипт:               неизвестно
    пер ПротоколВыполнения:            Массив<Строка>
    обз пер КонтекстИсполненияПроекта: IProjectProperties.КонтекстИсполнения

    @Глобально
    метод Инициализировать(МетодСкрипт: (Строка, Строка, Строка) -> ничто)

        ВыполнитьСкрипт                                 = МетодСкрипт
        ПараметрыЗаписиОтветаJSON                       = новый НастройкиЗаписиОбъектовJson()
        ПараметрыЗаписиОтветаJSON.ПереносСтрок          = ПереносСтрокJson.Отсутствует
        ПараметрыЗаписиОтветаJSON.РежимЗаписиТипа       = РежимЗаписиТипаJson.НеЗаписывать
        ПараметрыЗаписиОтветаJSON.ЭкранированиеСимволов = ЭкранированиеСимволовJson.СимволыВнеAscii

        McpServerInfo   = новый IMcpServerProperties.Info("1c-executor-mcp", "1.0.1")
        McpCapabilities = 
            новый IMcpServerProperties.McpCapabilities(новый IMcpServerProperties.McpToolsCapability())

        знч КомандыЗапуска = oc_main.ПолучитьКомандыЗапуска()
        КомандыЗапуска.Добавить("get_ib_list")

        пер АргументКлючИБ = новый Соответствие<Строка, IMcpServerProperties.PropertyDetails>()
        знч НетКлючей      = ПолучитьСписокИБ().Пусто()

        если не НетКлючей
            АргументКлючИБ.Вставить(
                "KeyIB",
                новый IMcpServerProperties.PropertyDetails("string", "Ключ ИБ")
            )
        ;

        для КомандаЗапуска из КомандыЗапуска
            если КомандаЗапуска.Содержит("build") или КомандаЗапуска.Содержит("get_ib_list") или НетКлючей
                ДобавитьTool(КомандаЗапуска, Неопределено)
            иначе
                ДобавитьTool(КомандаЗапуска, АргументКлючИБ)
            ;
        ;

    ;

    @Глобально
    метод Запустить()

        пер ОтветСервера         = новый IMcpServerProperties.ResponseServer()
        пер Тело                 = ""
        пер ПротоколЗапросов     = новый Файл("logRequest.txt")
        пер ПотокЗаписиПротокола = ПротоколЗапросов.ОткрытьПотокЗаписи()

        пока Истина

            попытка

                Тело = Консоль.СчитатьСтроку()
                ПотокЗаписиПротокола.Записать(Тело + Символы.НОВАЯ_СТРОКА) 

                если Тело.Пусто() или Тело.Содержит("notifications")
                    продолжить
                ;

                пер ЗапросСоответствие = СериализацияJson.ПрочитатьОбъект(
                    Тело,
                    Тип<Соответствие<Строка, Объект>>
                )

                знч Метод  = ЗапросСоответствие.Получить("method")
                пер result = Неопределено
                если Метод == "initialize"
                    result = Initialize(
                        СериализацияJson.ПрочитатьОбъект(Тело, Тип<IMcpServerProperties.McpRequestInit>)
                    )
                иначе если Метод == "tools/list"
                    result = ToolsList
                иначе если Метод == "tools/call"
                    result = ВызватьTool(
                        СериализацияJson.ПрочитатьОбъект(Тело, Тип<IMcpServerProperties.McpRequestCall>)
                    )
                ;

                если result != Неопределено
                    ОтветСервера.jsonrpc = ЗапросСоответствие.Получить("jsonrpc") как Строка
                    ОтветСервера.id      = ЗапросСоответствие.Получить("id") как Число
                    ОтветСервера.result  = result
                    ВывестиОтвет(ОтветСервера, ПотокЗаписиПротокола)
                ;

            поймать Исключение: неизвестно
                знч СообщениеОшибки = Исключение.Представление()
                ПотокЗаписиПротокола.Записать(СообщениеОшибки)
                ЗаписатьПротокол(СообщениеОшибки)
                прервать
            ;

        ;
    ;
    
    @Глобально
    метод Initialize(Запрос: IMcpServerProperties.McpRequestInit): IMcpServerProperties.Result

        возврат новый IMcpServerProperties.Result(
            Запрос.params.protocolVersion,
            McpCapabilities,
            McpServerInfo
        )

    ;

    @Глобально
    метод СформироватьОтвет(Запрос: неизвестно, result: Объект?): IMcpServerProperties.ResponseServer

        возврат новый IMcpServerProperties.ResponseServer(Запрос.jsonrpc, Запрос.id, result)

    ;

    @Локально
    метод ВывестиОтвет(Ответ: IMcpServerProperties.ResponseServer, ПотокЗаписиПротокола: ПотокЗаписи)

        пер ОтветСервераJSON = СериализацияJson.ЗаписатьОбъект(Ответ, ПараметрыЗаписиОтветаJSON)
        ОтветСервераJSON     = ОтветСервераJSON.Заменить("myType", "type")
        ПотокЗаписиПротокола.Записать(ОтветСервераJSON + Символы.НОВАЯ_СТРОКА)
        ПотокЗаписиПротокола.СброситьБуферы()
        Консоль.Записать(ОтветСервераJSON)

    ;

    @Локально
    метод ДобавитьTool(
            ИмяМетода:      Строка,
            Аргументы:      Соответствие<Строка, IMcpServerProperties.PropertyDetails>?,
            ТипСхемы:       Строка = "object"
        )

        пер Схема            = новый IMcpServerProperties.Schema(ТипСхемы)
        пер required         = новый Массив<Строка>()

        если Аргументы != Неопределено
            для Аргумент из Аргументы
                required.Добавить(Аргумент.Ключ)
            ;
            Схема.properties = Аргументы
            Схема.required   = [required.Соединить(",")]
        ;

        знч Описание = ПолучитьОписаниеTool(ИмяМетода)
        ToolsList.tools.Добавить(новый IMcpServerProperties.Tool(
            ИмяМетода,
            description = Описание, inputSchema = Схема)
        )

    ;

    @Локально
    метод ПолучитьСписокИБ(): Массив<Строка>
        
        пер МассивКлючей = новый Массив<Строка>()
        знч Настройки = IProjectProperties.Настройки.Прочитать(КонтекстИсполненияПроекта.ПутьКНастройкам)
        знч ПользовательскиеНастройки = IProjectProperties.ПользовательскиеНастройки.Прочитать(
            Настройки,
            oc_main.ДобавитьЧастьПути(
                КонтекстИсполненияПроекта.ПутьКНастройкам,
                [КонтекстИсполненияПроекта.ПутьКСборкеПроекта.ОтносительныйПуть]
            )
        )

        для IB из ПользовательскиеНастройки.IBS
            МассивКлючей.Добавить(IB.Ключ)
        ;

        возврат МассивКлючей

    ;

    @Глобально
    метод ВызватьTool(Запрос: IMcpServerProperties.McpRequestCall): Объект?

        знч Действие  = Запрос.params.name
        знч Аргументы = Запрос.params.arguments
        пер Результат = ВыполнитьКоманду(Действие, Аргументы)

        возврат Результат

    ;

    @Глобально
    метод ВыполнитьКоманду(Действие: Строка, Аргументы: Соответствие<Строка, Строка>): IMcpServerProperties.CallToolResult

        пер ПротоколВывода = ""
        пер КлючИБ         = ""
        пер КодВозврата    = 0
        пер Ошибка         = Ложь
        знч НуженКлюч      = Аргументы.СодержитКлюч("KeyIB")

        если не Аргументы.Пусто() и НуженКлюч
            КлючИБ = Аргументы.Получить("KeyIB")
        иначе если НуженКлюч
            Ошибка      = Истина
            ПротоколВывода = "Ошибка: Отсутствует параметр KeyIB"
        ;

        если не Ошибка
            если Действие == "get_ib_list"
                ПротоколВывода = ПолучитьСписокИБ().Представление()   
            иначе
                ВыполнитьСкрипт(Действие, " ", КлючИБ, (ЗаписьЖурнала: Строка) -> этот.ЗаписатьПротокол(Сообщение = ЗаписьЖурнала))
                ПротоколВывода = ПротоколВыполнения.Соединить("\н")
                ПротоколВыполнения.Очистить()
            ;
        ;

        ПротоколВывода   = "%{ПротоколВывода} Код возврата: %{КодВозврата}%{Символы.НОВАЯ_СТРОКА}"
        пер Результат = новый Массив<IMcpServerProperties.ToolContent>()
        Результат.Добавить(новый IMcpServerProperties.ToolContent("text", ПротоколВывода))

        возврат новый IMcpServerProperties.CallToolResult(Результат, КодВозврата != 0)

    ;

    @Глобально
    метод ЗаписатьПротокол(Сообщение: Строка)
        ПротоколВыполнения.Добавить(Сообщение)
    ;

    @Локально
    метод ПолучитьОписаниеTool(Команда: Строка): Строка

        пер Описание = ""

        если Команда == "platform_test"
            Описание = "platform_test"
        иначе если Команда == "check_ib_cf"
            Описание = "тестирование конфигурации информационной базы"
        иначе если Команда == "check_ib_cfe"
            Описание = "тестирование расширений информационной базы"
        иначе если Команда == "check_ib"
            Описание = "тестирование и исправление (ТИС) информационной базы"
        иначе если Команда == "build_cf"
            Описание = "сборка файла конфигурации из файловой выгрузки xml"
        иначе если Команда == "build_prod"
            Описание = "сборка файла конфигурации из файловой выгрузки xml"
                + "\нс дополнительным конвертацией конфигурацией поставщика"
                + "\нс целью устранения шума ложных различий между основной конфигурацией и конфигурацией поставщика"
        иначе если Команда == "build_cfe"
            Описание = "сборка файлов расширений из файловой выгрузки xml"
        иначе если Команда == "build_patch"
            Описание = "сборка архива для обновления из файловой выгрузки xml только по полностью или частично снятых с поддержки объектов"
        иначе если Команда == "get_ib_configdumpinfo"
            Описание = "получение файла bin/.1ccicd/ConfigDumpInfo.xml из информационной базы,"
                + "\нгде идет разработка, для ускоренной выгрузки в файлы xml измененной конфигурации."
        иначе если Команда == "get_ib_xml"
            Описание = "получение файловой выгрузки из конфигурации информационной базы, где идет разработка"
        иначе если Команда == "get_ib_xml_cfe"
            Описание = "получение файловой выгрузки из расширений информационной базы, где идет разработка"
        иначе если Команда == "get_ib_status"
            Описание = "получение состояния конфигурации относительно раннее полученного файла bin/.1ccicd/ConfigDumpInfo.xml из информационной базы"
        иначе если Команда == "update_ib_cf"
            Описание = "обновление информационной базы собранным файлом cf"
        иначе если Команда == "update_ib_cf_xml"
            Описание = "обновление информационной базы из файловой выгрузки xml конфигурации"
        иначе если Команда == "update_ib_cfe"
            Описание = "обновление информационной базы собранными файлами cfe"
        иначе если Команда == "update_ib_cfe_xml"
            Описание = "обновление информационной базы из файловой выгрузки xml расширений"
        иначе если Команда == "update_ib_patch"
            Описание = "частичное обновление информационной базы файлами из каталога с файлами полностью или частично снятых с поддержки объектов"
        иначе если Команда == "update_ib"
            Описание = "применение изменений к информационной базе"
        иначе если Команда == "git_sync_xml"
            Описание = "синхронизация хранилища 1С и **git**-хранилища"
        иначе если Команда == "git_commit_ib_xml"
            Описание = "выгрузка и фиксация изменений из конфигурации информационной базы в **git**-хранилищ"
        ;

        возврат Описание
    ;

;

