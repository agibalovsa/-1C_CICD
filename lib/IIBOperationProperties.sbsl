#!/usr/bin/executor

#требуется oc_main.sbsl

@Глобально
перечисление РежимыИсполнения

    Предприятие
    АвтономныйСервер
    РежимАгента

;

@Глобально
структура Предприятие

    знч Путь: Строка

;

@Глобально
структура АвтономныйСервер

    знч Путь: Строка

;

@Глобально
структура КлиентКластера

    знч Путь: Строка

;

@Глобально
структура ПараметрыИБ

    пер ЭтоСервернаяИБ: Булево
    пер Имя:   Строка
    пер Адрес: Строка
    пер Порт:  Число = 1545
    пер ПутьКФайловойИБ: Строка
    пер ИД: Ууид

    @Глобально
    метод Инициализировать(СтрокаСоединения: Строка)

        если oc_main.ЭтоСервернаяИБ(СтрокаСоединения)
            ЭтоСервернаяИБ = Истина
            знч Образец = '"?Srvr=""?(?<Адрес>.*?):?(?<Порт>\ц*?)""?;Ref=""?(?<НаименованиеИБ>.*?)""?;"?'
            знч ПараметрыСоединенияИБ = Образец.НайтиСовпадения(СтрокаСоединения)
            для Совпадения из ПараметрыСоединенияИБ
                Адрес = Совпадения.Группа("Адрес")
                знч ГруппаПорт = Совпадения.Группа("Порт")
                если не ГруппаПорт.Пусто() и ГруппаПорт.ТолькоЦифры()
                    Порт = новый Число(ГруппаПорт.ПодстрокаСНачала(2)) * 100 + 45
                ;
                Имя = Совпадения.Группа("НаименованиеИБ")
            ;
        иначе
            ПутьКФайловойИБ  = oc_main.ПреобразоватьВПутьКИнформационнойБазе(СтрокаСоединения)
        ;

    ;

;

@Глобально
перечисление РежимыРаботыСКластером

    Агент
    Элемент

;

@Глобально
структура ПараметрыСоединенияКластера

    обз пер Адрес:                Строка
    пер Порт:                     Число = 1545
    пер ЛогинСервера:             Строка
    пер ПарольСервера:            Строка
    пер ЛогинКластера:            Строка
    пер ПарольКластера:           Строка
    пер Версия:                   Строка
    пер ИД:                       Ууид
    пер ПериодПерезапуска:        Число
    пер РасписаниеПерезапуска:    Строка? = Неопределено
    пер РежимРаботыСКластером:    РежимыРаботыСКластером = РежимыРаботыСКластером.Агент
    пер ИсполняемыйФайлПлатформы: Строка

;

@Глобально
структура ПараметрыСоединенияХранилища

    пер Путь:   Строка
    пер Логин:  Строка
    пер Пароль: Строка

;

@Глобально
структура ПараметрыСоединенияИБ

    знч Имя:                Строка
    знч СтрокаСоединения:   Строка
    знч ПараметрыИБ:        ПараметрыИБ
    знч Логин:              Строка
    знч Пароль:             Строка
    знч КодРазрешения:      Строка
    знч ПутьКФайлуВыгрузки: Строка
    знч ВедетсяРазработка:  Булево
    обз знч Платформа:      Платформа
    обз знч ПараметрыСоединенияКластера: ПараметрыСоединенияКластера
    знч ПараметрыСоединенийХранилищ: Соответствие<Строка, ПараметрыСоединенияХранилища>

    @Глобально
    метод ПолучитьПутьКФайлуВыгрузки(): Строка

        знч ОбразецПоиска = '\{(?<ФорматДаты>[^}]+)\}'
        знч Параметры = ОбразецПоиска.НайтиСовпадения(ПутьКФайлуВыгрузки)
        пер ФорматДаты = ""
        для Параметр из Параметры
            ФорматДаты = Параметр.Группа("ФорматДаты")
        ;
        знч Представление = ПутьКФайлуВыгрузки.Заменить(ОбразецПоиска, Дата.Сейчас().Представление(ФорматДаты))

        возврат Представление
    ;

;

@Глобально
структура ПараметрыХранилища

    знч Используется:        Булево
    пер ТекущийНомерВерсии:  Строка
    пер ПараметрыСоединения: ПараметрыСоединенияХранилища

;

@Глобально
структура Конфигурация

    обз знч ПутьКФайламКонфигурации: oc_main.ПутьКФайламПроекта // Путь к исходным файлам конфигурации проекта
    знч ПараметрыХранилища:          ПараметрыХранилища

;

@Глобально
структура Платформа

    обз знч ПутьКФайламПлатформы:   Строка // Путь к исполняемым файлу платформы
    обз знч ПутьКСкриптуИсполнения: oc_main.ПутьКФайламПроекта
    знч РежимИсполнения:            РежимыИсполнения = РежимыИсполнения.Предприятие
    знч РежимИСполненияРасширения:  РежимыИсполнения = РежимыИсполнения.Предприятие
    знч Предприятие:                Предприятие
    знч АвтономныйСервер:           АвтономныйСервер
    знч КлиентКластера:             КлиентКластера
    знч Проверки:                   Массив<Строка>
    знч ПроверкиТИС:                Массив<Строка>
    знч ПараметрыОбновления:        Массив<Строка>

;