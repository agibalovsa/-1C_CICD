#!/usr/bin/executor

#требуется ILogging.sbsl

@Глобально
перечисление ОперационныеСистемы
    Windows,
    Linux
;

@Глобально
перечисление РежимыСравнения

    СравнитьСКонфигурациейИБ
    СравнитьСКонфигурациейПоставщика

;

@Глобально
структура ПутьКФайламПроекта

    обз знч Имя:  Строка
    обз знч ФайлыПроекта: Файл
    знч ОтносительныйПуть: Строка
    знч ЭтоРасширение: Булево
    знч Формат: Строка
    пер Хеш: Строка
;

@Глобально
структура КлючВыполненияПрограммы
    
    знч Ключ: Строка
    знч Значение: Строка?
    знч Маскировать: Булево = Ложь
    
;

@Глобально
структура ВыполняемаяПрограмма
    
    знч Программа: Строка
    знч ПолучитьПараметрВыполнения: ((Строка, Строка?, Булево, Булево) -> Массив<Строка>)?
    знч КлючиВыполнения: Массив<КлючВыполненияПрограммы>
    пер ФайлКодаВозврата: Файл?
    пер ФайлВывода: Файл?

;

@Глобально
метод ПолучитьКомандыЗапуска(): Массив<Строка>

    возврат [
        "platform_test",
        "check_ib_cf",
        "check_ib_cfe",
        "check_ib",
        "build_cf",
        "build_prod",
        "build_cfe",
        "build_patch",
        "get_ib_configdumpinfo",
        "get_ib_xml",
        "get_ib_xml_cfe",
        "get_ib_status",
        "update_ib_cf",
        "update_ib_cf_xml",
        "update_ib_cfe",
        "update_ib_cfe_xml",
        "update_ib_patch",
        "update_ib",
        "archive_ib",
        "replicate_ib",
        "git_sync_ib_xml",
        "git_commit_ib_xml"
    ]

;

@Глобально
структура Исполнитель

    знч Инструкции: Массив<ВыполняемаяПрограмма>
    пер Таймаут:    Длительность = 0с

    // ПрограммныйИнтерфейс

    @Глобально
    метод ДобавитьВыполняемуюПрограмму(Программа: Строка, ПолучитьПараметрВыполнения: ((Строка, Строка?, Булево, Булево)->Массив<Строка>)? = Неопределено)
        если ПолучитьПараметрВыполнения == Неопределено
            Инструкции.Добавить(новый ВыполняемаяПрограмма(Программа, &СоединитьКлючИЗначение))
        иначе
            Инструкции.Добавить(новый ВыполняемаяПрограмма(Программа, ПолучитьПараметрВыполнения))
        ;
    ;

    @Глобально
    метод ДобавитьКлючВыполненияПрограммы(Ключ: Строка, Значение:Строка? = Неопределено, Маскировать = Ложь)
        если Инструкции.Размер() == 0
            возврат
        ;
        знч КлючиВыполнения = Инструкции.Последний().КлючиВыполнения
        КлючиВыполнения.Добавить(
            новый КлючВыполненияПрограммы(Ключ, Значение, Маскировать)
        )
    ;

    @Глобально
    метод СброситьКлючиВыполненияПрограммы()
        если Инструкции.Размер() == 0
            возврат
        ;
        знч КлючиВыполнения = Инструкции.Последний().КлючиВыполнения
        КлючиВыполнения.Очистить()
    ;

    @Глобально
    метод ВыполнитьКомандуПлатформыСОжиданием(): Строка

        пер Процесс: ПроцессОс? = Неопределено
        пер ЛогВыполнения = новый Массив<Строка>()
        
        для ВыполняемаяПрограмма из Инструкции

            знч ПараметрыВыполнения = новый Массив<Строка>()
            пер ПараметрыСтрокой = ""
            
            для КлючВыполнения из ВыполняемаяПрограмма.КлючиВыполнения
                знч ПараметрВыполнения = ВыполняемаяПрограмма.ПолучитьПараметрВыполнения(КлючВыполнения.Ключ, КлючВыполнения.Значение, Ложь, Ложь)
                ПараметрыВыполнения.ДобавитьВсе(ПараметрВыполнения)
                ПараметрыСтрокой = ПараметрыСтрокой + " "
                    + ВыполняемаяПрограмма.ПолучитьПараметрВыполнения(КлючВыполнения.Ключ, КлючВыполнения.Значение, Истина, КлючВыполнения.Маскировать).Соединить(" ")
            ;
            ПараметрыСтрокой = ПараметрыСтрокой.Сократить()
            
            если Процесс == Неопределено
                Процесс = новый ПроцессОс(ВыполняемаяПрограмма.Программа, ПараметрыВыполнения)
            иначе
                Процесс.ПередатьВыводВ(ВыполняемаяПрограмма.Программа, ПараметрыВыполнения)
            ;

            ЛогВыполнения.Добавить("\"%{ВыполняемаяПрограмма.Программа}\" %{ПараметрыСтрокой}")

        ;

        Процесс.Запустить()

        Консоль.Записать("=================================================================")
        Консоль.Записать("PID Процесса: %{Процесс.ПолучитьPid()}")
        для ЛогКоманды из ЛогВыполнения
            Консоль.Записать("=================================================================")
            Консоль.Записать(ЛогКоманды)
        ;
        Консоль.Записать("=================================================================")

        пер ВремяОжидания = 0с
        пер КодВозврата = Неопределено
        пер ТекстСообщения  = ""
        пер ТекстИсключения = ""

        пока не Процесс.ОжидатьЗавершения(60с) и Процесс.Живой()

            если Инструкции.Последний().ФайлКодаВозврата != Неопределено
                КодВозврата = ПолучитьКодВозвратаИзФайла(Инструкции.Последний().ФайлКодаВозврата)
            ;

            если КодВозврата != Неопределено
                Процесс.ОжидатьЗавершения(10с)
                прервать
            ;

            если Таймаут != 0с и Таймаут <= ВремяОжидания
                пер текстОшибки = "При выполнении команды платформы превышено время ожидания выполнения %Таймаут"
                Процесс.Остановить()
                выбросить новый ИсключениеНедопустимоеСостояние(текстОшибки)
            ;
            ВремяОжидания += 60с
        ;

        если КодВозврата == Неопределено
            если Инструкции.Последний().ФайлКодаВозврата != Неопределено
                КодВозврата = ПолучитьКодВозвратаИзФайла(Инструкции.Последний().ФайлКодаВозврата)
            иначе
                КодВозврата = Процесс.ПолучитьКодВозврата()
            ;
        ;

        область
            знч ДанныеВывода = Процесс.ПолучитьПотокВывода().ПрочитатьКакБайты()
            ТекстСообщения = ПолучитьТекстСообщения(ДанныеВывода)
        ;

        если Инструкции.Последний().ФайлВывода != Неопределено и Инструкции.Последний().ФайлВывода.Существует()
            знч ДанныеВывода = Инструкции.Последний().ФайлВывода.ОткрытьПотокЧтения().ПрочитатьКакБайты()
            ТекстСообщения = ТекстСообщения + Символы.НОВАЯ_СТРОКА + ПолучитьТекстСообщения(ДанныеВывода)
        ;

        если Процесс.Живой()
            Процесс.Остановить()
        ;

        если Инструкции.Последний().ФайлКодаВозврата != Неопределено
            Файлы.Удалить(Инструкции.Последний().ФайлКодаВозврата)
        ;
        если Инструкции.Последний().ФайлВывода != Неопределено
            Файлы.Удалить(Инструкции.Последний().ФайлВывода)
        ;

        если КодВозврата == 0 или КодВозврата == Неопределено
            возврат ТекстСообщения
        ;

        Консоль.Записать("Код возврата: %{КодВозврата}")

        если ТекстСообщения.Содержит("Ошибка при выполнении файловой операции")
            ТекстИсключения = "ОшибкаСтруктуры"
        ;

        выбросить новый ИсключениеНедопустимоеСостояние(ТекстИсключения)
    ;

    // СлужебныеПроцедурыИФункции

    @Локально
    метод ПолучитьКодВозвратаИзФайла(ФайлКодаВозврата: Файл): Число|Строка?

        если не ФайлКодаВозврата.Существует()
            возврат Неопределено
        ;

        пер КодВозврата = ФайлКодаВозврата.ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        если КодВозврата.Пусто()
            возврат Неопределено
        ;
        
        если КодВозврата.ТолькоЦифры()
            возврат новый Число(КодВозврата)
        ;
        
        возврат КодВозврата.Сократить()
    ;

    @Локально
    метод ПолучитьТекстСообщения(ДанныеСообщения: Байты): Строка

        пер ТекстСообщения = ""
        пер ТекущаяКодировка: Кодировка? = Неопределено
        знч СтраницыКодировок   = новый Массив<Кодировка>()
        СтраницыКодировок.Добавить(Кодировка.Utf8)
        СтраницыКодировок.Добавить(Кодировка.Cp866)
        СтраницыКодировок.Добавить(Кодировка.Windows1251)
        СтраницыКодировок.Добавить(Кодировка.Koi8r)
        СтраницыКодировок.Добавить(Кодировка.Ascii)
        для СтраницаКодировки из СтраницыКодировок
            ТекстСообщения = ПотокЧтения.ИзБайтов(ДанныеСообщения).ПрочитатьКакСтроку(СтраницаКодировки)
            если ТекстСообщения.Пусто() или не ТекстСообщения.Содержит('[^ -~А-я\n\r]')
                ТекущаяКодировка = СтраницаКодировки
                прервать
            ;
        ;
        если ТекущаяКодировка == Неопределено
            ТекстСообщения = ПотокЧтения.ИзБайтов(ДанныеСообщения).ПрочитатьКакСтроку(Кодировка.Utf8)
            ТекущаяКодировка = Кодировка.Utf8
        ;

        если не ТекстСообщения.Пусто()
            Консоль.Записать("(Кодировка: %{ТекущаяКодировка.Представление()})\н%{ТекстСообщения}")
        ;

        возврат ТекстСообщения

    ;

    @Локально
    метод СоединитьКлючИЗначение(Ключ: Строка, Значение: Строка?, Экранировать = Ложь, Маскировать = Ложь): Массив<Строка>

        знч Кавычки     =
            (Значение == Неопределено)
                или не Значение.Содержит(" ")
                или не Экранировать
                или Маскировать
                или (Значение.НачинаетсяС("\"") и Значение.ЗаканчиваетсяНа("\""))
            ? ""
            : "\""
        знч Разделитель = (
            Ключ.Пусто() или Значение == Неопределено ? ""
            : Ключ.НачинаетсяС("--") ? "="
            : Ключ.НачинаетсяС("-") ? " "
            : Ключ.НачинаетсяС("/") ? " "
            : ""
        )
        знч ЗначениеКлюча =
            Кавычки
            + (Значение == Неопределено ? "" : Маскировать и не Значение.Пусто() ? "**********" : Значение)
            + Кавычки
        знч ПараметрыВыполнения = новый Массив<Строка>()
        если Разделитель == " "
            ПараметрыВыполнения.Добавить(Ключ)
            ПараметрыВыполнения.Добавить(ЗначениеКлюча)
        иначе
            ПараметрыВыполнения.Добавить(Ключ + Разделитель + ЗначениеКлюча)
        ;
        возврат ПараметрыВыполнения

    ;

;

@Глобально
метод ПутьКФайламПлатформы(ВерсияПлатформы: Строка, ПутьКВерсиямПлатформы = ""): Строка

    возврат ПутьКФайламПлатформыПоМаксимальнойСборке(ВерсияПлатформы, ПутьКВерсиямПлатформы)
;

@Глобально
метод ИсполняемыйФайлПлатформы(ПутьКФайламПлатформы: Строка, ТипФайла = 0): Строка

    пер ИсполняемыйФайл = ""
    знч ИспользуемаяОС = ИспользуемаяОС()
    
    выбор ТипФайла
    когда 0
        ИсполняемыйФайл = "1cv8"
    когда 1
        ИсполняемыйФайл = "ibcmd"
    когда 2
        ИсполняемыйФайл = "rac"
    ;

    если ИсполняемыйФайл.Пусто()
        возврат ИсполняемыйФайл
    ;

    выбор ИспользуемаяОС
    когда ОперационныеСистемы.Windows
        ИсполняемыйФайл = "%{ИсполняемыйФайл}.exe"
    ;

    возврат ДобавитьЧастьПути(ПутьКФайламПлатформы, [ИсполняемыйФайл])

;

@Глобально
метод ЭтоСервернаяИБ(ПутьКИБ: Строка): Булево

    возврат ПутьКИБ.Содержит("Srvr=")
;

@Глобально
метод ЭтоФайловаяИБ(ПутьКИБ: Строка): Булево

    возврат ПутьКИБ.Содержит("File=")
;

@Глобально
метод ЭтоСтрокаСоединения(ПутьКИБ: Строка): Булево

    возврат ЭтоСервернаяИБ(ПутьКИБ) или ЭтоФайловаяИБ(ПутьКИБ)
;

@Глобально
метод ПреобразоватьВСтрокуСоединения(ПутьКИБ: Строка): Строка

    если ЭтоСтрокаСоединения(ПутьКИБ)
        возврат ПутьКИБ
    ;

    возврат "\"File=\"\"%{ПутьКИБ}\"\";\""
;

@Глобально
метод ПреобразоватьВПутьКИнформационнойБазе(СтрокаСоединения: Строка): Строка

    если не ЭтоФайловаяИБ(СтрокаСоединения)
        возврат СтрокаСоединения
    ;

    возврат СтрокаСоединения.Заменить("File=", "").Заменить(";", "").Заменить("\"", "")
;

@Глобально
метод ЭтоАбсолютныйПуть(Путь: Строка): Булево

    знч СР = Файлы.СимволРазделителя

    возврат Путь.Содержит(":") или Путь.НачинаетсяС(СР) или Путь.НачинаетсяС("~")
;

@Глобально
метод ИспользуемаяОС(): ОперационныеСистемы
    знч имяОС = СредаИсполнения.ПолучитьСвойство("os.name")

    выбор когда имяОС.НачинаетсяС("windows", Истина)
        возврат ОперационныеСистемы.Windows
    когда имяОС.Содержит("nux", Истина)
        возврат ОперационныеСистемы.Linux
    иначе
        выбросить новый ИсключениеНедопустимоеСостояние("Неизвестная ОС")
    ;
;

@Глобально
метод ДобавитьЧастьПути(Путь: Строка, Части: Массив<Строка>): Строка

    возврат ИзменитьЧастьПути(Путь, Части, "+")
;

@Глобально
метод УдалитьЧастьПути(Путь: Строка, Части: Массив<Строка>): Строка

    возврат ИзменитьЧастьПути(Путь, Части, "-")
;

@Глобально
метод ИсправитьРазделителиПути(Путь: Строка): Строка

    знч СР = Файлы.СимволРазделителя
    возврат Путь.Заменить("/", СР).Заменить("\\", СР)

;

@Глобально
метод УдалитьФайлСКонтролемОшибок(
        УдаляемыйФайл: Файл|Строка,
        ОчиститьКаталог = Ложь,
        Логирование: ILogging.Логирование
    )

    знч Файл = УдаляемыйФайл.ПолучитьТип() == Тип<Строка> ? новый Файл(УдаляемыйФайл как Строка) : УдаляемыйФайл как Файл

    попытка
        пер ФайлУдален = Ложь
        знч ЭтоКаталог = Файл.ЭтоКаталог()
        если Файл.Существует()
            Файлы.Удалить(Файл)
            ФайлУдален = Истина
        ;
        если ЭтоКаталог и ОчиститьКаталог
            Файлы.СоздатьКаталог(Файл)
        ;
        если ФайлУдален и ЭтоКаталог
            Логирование.ВывестиСообщение("\нКаталог %{Файл.Путь} очищен")
        иначе если ФайлУдален
            Логирование.ВывестиСообщение("\нФайл %{Файл.Путь} очищен")
        ;
    поймать Исключение: Исключение
        если не Исключение.Описание.Пусто()
            Логирование.ВывестиСообщение("\н#################################################################")
            Логирование.ВывестиСообщение(Исключение.Информация())
            Логирование.ВывестиСообщение("#################################################################")
        ;
    ;
;

@Локально
метод ИзменитьЧастьПути(Путь: Строка, Части: Массив<Строка>, Режим: Строка): Строка

    знч СР = Файлы.СимволРазделителя

    пер ФорматПуть = Путь + (Путь.ЗаканчиваетсяНа(СР) или Путь.Пусто() ? "" : СР)

    пер УдалитьНачальныйСимвол = Ложь

    для Часть из Части
        если Часть.Пусто()
            продолжить
        ;
        пер ФорматЧасть = Часть
        пока Режим == "+" и ФорматЧасть.НачинаетсяС(СР)
            ФорматЧасть = ФорматЧасть.ПодстрокаСКонца(ФорматЧасть.Длина() - 1)
        ;
        пока Режим == "-" и ФорматЧасть.ЗаканчиваетсяНа(СР)
            ФорматЧасть = ФорматЧасть.ПодстрокаСНачала(ФорматЧасть.Длина() - 1)
        ;
        если Режим == "+"
            ФорматПуть = ФорматПуть + ФорматЧасть + (ФорматЧасть.ЗаканчиваетсяНа(СР) ? "" : СР)
        иначе если Режим == "-"
            знч ЭтоОсновнойПуть = ФорматПуть.НачинаетсяС(ФорматЧасть)
            если ЭтоОсновнойПуть
                УдалитьНачальныйСимвол = Истина
            ;
            ФорматПуть = ФорматПуть.Заменить((ФорматЧасть.НачинаетсяС(СР) или ЭтоОсновнойПуть ? "" : СР) + ФорматЧасть, "", Истина)
        ;
    ;

    если ФорматПуть.ЗаканчиваетсяНа(СР)
        ФорматПуть = ФорматПуть.ПодстрокаСНачала(ФорматПуть.Длина() - 1)
    ;

    если УдалитьНачальныйСимвол и ФорматПуть.НачинаетсяС(СР)
        ФорматПуть = ФорматПуть.ПодстрокаСКонца(ФорматПуть.Длина() - 1)
    ;

    возврат ФорматПуть
;

@Локально
метод ПутьКФайламПлатформыПоМаксимальнойСборке(ВерсияПлатформы: Строка, ПутьКВерсиямПлатформы = ""): Строка

    пер ПутьКФайламПлатформы = ""
    знч ИспользуемаяОС = ИспользуемаяОС()

    если ВерсияПлатформы.КоличествоВхождений(".") == 3
        знч УстановленныеПлатформы = УстановленныеПлатформы(ПутьКВерсиямПлатформы)
        если УстановленныеПлатформы.СодержитКлюч(ВерсияПлатформы)
            ПутьКФайламПлатформы = УстановленныеПлатформы.Получить(ВерсияПлатформы)
        ;
    ;

    знч МаксимальныеПлатформы = МаксимальныеПлатформы(ПутьКВерсиямПлатформы)
    если ВерсияПлатформы.КоличествоВхождений(".") == 2 и МаксимальныеПлатформы.СодержитКлюч(ВерсияПлатформы)
        ПутьКФайламПлатформы = МаксимальныеПлатформы.Получить(ВерсияПлатформы)
    ;

    пер КлючиВерсий = новый Массив<Строка>(МаксимальныеПлатформы.Ключи())

    если ВерсияПлатформы.Пусто() и не КлючиВерсий.Пусто()
        КлючиВерсий = КлючиВерсий.Сортировать((строка1, строка2) -> строка2.Сравнить(строка1, Истина)) // по убыванию
        ПутьКФайламПлатформы = МаксимальныеПлатформы.Получить(КлючиВерсий[0])
    ;

    если не ПутьКФайламПлатформы.Пусто() и ИспользуемаяОС == ОперационныеСистемы.Windows
        возврат ДобавитьЧастьПути(ПутьКФайламПлатформы, ["bin"])
    иначе если не ПутьКФайламПлатформы.Пусто()
        возврат ПутьКФайламПлатформы
    ;

    знч текстОшибки = "Не найдена установленная платформа %ВерсияПлатформы" 
    выбросить новый ИсключениеНедопустимоеСостояние(текстОшибки)
;

@Локально
метод УстановленныеПлатформы(ПутьКВерсиямПлатформы = ""): Соответствие<Строка, Строка>

    знч УстановленныеПлатформы: Соответствие<Строка, Строка>
    знч ИспользуемаяОС = ИспользуемаяОС()

    знч КаталогиПлатформы = КаталогиПлатформыПоУмолчанию()
    если не ПутьКВерсиямПлатформы.Пусто()
        КаталогиПлатформы.Добавить(новый Файл(ПутьКВерсиямПлатформы))
    ;

    знч НастройкиПоискаФайлов = новый НастройкиПоискаФайлов()
        .ИсключитьФайлы(Истина)
        .МаксимальнаяГлубина(1)

    для КаталогПлатформы из КаталогиПлатформы
        если не КаталогПлатформы.Существует()
            продолжить
        ;

        знч ВерсииПлатформы = Файлы.Найти(КаталогПлатформы, НастройкиПоискаФайлов)
        для ВерсияПлатформы из ВерсииПлатформы
            если не ВерсияПлатформы.Имя.ПолноеСовпадение(новый Образец("[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+"))
                продолжить
            ;
            знч ИсполняемыйФайлПлатформы = ИспользуемаяОС == ОперационныеСистемы.Windows
                ? ИсполняемыйФайлПлатформы(ДобавитьЧастьПути(ВерсияПлатформы.Путь, ["bin"]))
                : ИсполняемыйФайлПлатформы(ВерсияПлатформы.Путь)
            знч ФайлИсполнения = новый Файл(ИсполняемыйФайлПлатформы)
            если ФайлИсполнения.Существует()
                УстановленныеПлатформы.Вставить(ВерсияПлатформы.Имя, ВерсияПлатформы.Путь)
            ;
        ;
    ;

    возврат УстановленныеПлатформы
;

@Локально
метод МаксимальныеПлатформы(ПутьКВерсиямПлатформы = ""): Соответствие<Строка, Строка>

    знч УстановленныеПлатформы = УстановленныеПлатформы(ПутьКВерсиямПлатформы)
    знч МаксимальныеПлатформы: Соответствие<Строка, Строка>

    для Платформа из УстановленныеПлатформы

        знч СоставПлатформы = Платформа.Ключ.Разделить(".")

        пер релизБезВерсииМассивом = новый Массив<Строка>(СоставПлатформы)
        релизБезВерсииМассивом.УдалитьПоИндексу(3)

        знч релизБезВерсии = Строки.Соединить(релизБезВерсииМассивом, ".")

        если не МаксимальныеПлатформы.СодержитКлюч(релизБезВерсии)
            МаксимальныеПлатформы.ВставитьЕслиОтсутствует(релизБезВерсии, Платформа.Значение)
        продолжить
        ;

        знч последнийРелиз = МаксимальныеПлатформы.Получить(релизБезВерсии)
        знч разложенныйПоследнийРелиз = последнийРелиз.Разделить(".")

        если СоставПлатформы[3] > разложенныйПоследнийРелиз[3]
            МаксимальныеПлатформы.Вставить(релизБезВерсии, Платформа.Значение)
        ;
    ;

    возврат МаксимальныеПлатформы
;

@Локально
метод КаталогиПлатформыПоУмолчанию(): Массив<Файл>

    пер Каталоги: Массив<Файл>
    знч ИспользуемаяОС = ИспользуемаяОС()

    выбор ИспользуемаяОС
    когда ОперационныеСистемы.Windows
        знч Каталог32 = СредаИсполнения.ПолучитьПеременную("ProgramFiles(x86)")
        Каталоги.Добавить(новый Файл(ДобавитьЧастьПути(Каталог32, ["1cv8"])))
        знч Каталог64 = СредаИсполнения.ПолучитьПеременную("ProgramFiles")
        Каталоги.Добавить(новый Файл(ДобавитьЧастьПути(Каталог64, ["1cv8"])))
    когда ОперационныеСистемы.Linux
        Каталоги.Добавить(новый Файл(ДобавитьЧастьПути("/", ["opt", "1cv8", "x86_64"])))
    ;

    возврат Каталоги
;