#!/usr/bin/executor

#требуется IProjectProperties.sbsl
#требуется IConfigurationProperties.sbsl
#требуется IConfiguration.sbsl
#требуется IIBOperationProperties.sbsl
#требуется IIBOperation.sbsl
#требуется IGit.sbsl
#требуется ILogging.sbsl
#требуется oc_main.sbsl

// ПрограммныйИнтерфейс

@Глобально
метод ВыполнитьТестированиеПлатформы(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ЧислоИтераций: Число
    ) : Булево

    пер Статус = Истина

    для Итерация = 1 по ЧислоИтераций

        для Конфигурация из ПараметрыПроекта.Конфигурации
            Конфигурация.Значение.Хеш = ""
        ;

        если Итерация % 10 == 0
            Статус = СобратьКонфигурацию(ПараметрыПроекта)
        иначе
            Статус = ПодготовитьКонфигурацию(ПараметрыПроекта)
        ;

        если не Статус
            прервать
        ;

        Статус = СобратьКонфигурацию(ПараметрыПроекта, Истина)
        если не Статус
            прервать
        ;
    ;

    возврат Статус

;


@Глобально
метод СобратьКонфигурацию(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        СобратьРасширения: Булево = Ложь, ПересобратьКонфигурациюПоставщика: Булево = Ложь, ИмяРасширения = ""
    ) : Булево

    знч СобранныеПроекты = новый Массив<Строка>()
    знч ОшибочныеПроекты = новый Массив<Строка>()
    пер Статус = Истина

    если не СобратьРасширения
        знч ОсновнаяКонфигурация = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
        если не ОсновнаяКонфигурация.СтруктураКонфигурации.ФайлыКонфигурацииСуществуют()
            возврат Статус
        ;
        ПараметрыПроекта.Логирование.НачатьЗамер("ПолучитьФайлКонфигурации")
        знч СтатусПолучения = ПолучитьФайлКонфигурации(
            ПараметрыПроекта,
            ОсновнаяКонфигурация,
            ПересобратьКонфигурациюПоставщика
        )
        знч Длительность = ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлКонфигурации")
        знч ТекстСборки = "%{ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()} (%{Длительность.Представление("с")} сек.)"
        если СтатусПолучения == 1
            СобранныеПроекты.Добавить(ТекстСборки)
        иначе если СтатусПолучения == 2
            ОшибочныеПроекты.Добавить(ТекстСборки)
        ;
        Статус = Статус и СтатусПолучения < 2
    ;

    пер ПодготовитьКонфигурацию = Истина
    для Расширение из ПараметрыПроекта.ПолучитьРасширения()
        если не СобратьРасширения
            прервать
        ;
        если не Расширение.СтруктураКонфигурации.ФайлыКонфигурацииСуществуют()
            продолжить
        ;
        если не ИмяРасширения.Пусто() и не ИмяРасширения == Расширение.СтруктураКонфигурации.ПолучитьИмяКонфигурации()
            продолжить
        ;
        если ПодготовитьКонфигурацию
            ПодготовитьКонфигурацию(ПараметрыПроекта)
            ПодготовитьКонфигурацию = Ложь
        ;
        ПараметрыПроекта.Логирование.НачатьЗамер("ПолучитьФайлРасширения")
        знч СтатусПолучения = ПолучитьФайлКонфигурации(
            ПараметрыПроекта,
            Расширение,
            Ложь
        )
        знч Длительность = ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлРасширения")
        знч ТекстСборки = "%{Расширение.СтруктураКонфигурации.ПолучитьИмяКонфигурации()} (%{Длительность.Представление("с")} сек.)"
        если СтатусПолучения == 1
            СобранныеПроекты.Добавить(ТекстСборки)
        иначе если СтатусПолучения == 2
            ОшибочныеПроекты.Добавить(ТекстСборки)
        ;
        Статус = Статус и СтатусПолучения < 2
    ;

    ВывестиИнформациюПоПроектам(СобранныеПроекты, Логирование = ПараметрыПроекта.Логирование)
    ВывестиИнформациюПоПроектам(ОшибочныеПроекты, 2, ПараметрыПроекта.Логирование)

    возврат Статус
;

@Глобально
метод СобратьПатчКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза? = Неопределено
    ): Булево

    пер Статус = Ложь // 0 - патч собрать нельзя, 1 - патч собран, обновление не требуется, 2 - патч собран, обновление требуется
    
    знч СобранныеПроекты = новый Массив<Строка>()
    знч ОсновнаяКонфигурация =
        ИнформационнаяБаза == Неопределено
        ? ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
        : ИнформационнаяБаза.Конфигурация
    
    знч КонфигурацияПатча = ПараметрыПроекта.ПолучитьКонфигурациюПатча()

    область
        знч ФайлИзменений = ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
        если не ФайлИзменений.Существует()
            ПараметрыПроекта.Логирование.ВывестиСообщение("\нКонфигурация не на поддержке")
            возврат Статус
        ;
    ;

    ПараметрыПроекта.Логирование.НачатьЗамер("СобратьПатчКонфигурации")

    знч КаталогСборкиПатча = КонфигурацияПатча.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    знч ФайлЗагрузкиПатча  = новый Файл("%{КаталогСборкиПатча.Путь}_in")
    знч ИБВыгрузки         = ПараметрыПроекта.ПолучитьИнформационнуюБазуВыгрузки(ИнформационнаяБаза, "%{КаталогСборкиПатча.Путь}_temp")
    пер ФайлПоставщика     = ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьФайлПоставщика()

    если КаталогСборкиПатча.Существует()
        oc_main.УдалитьФайлСКонтролемОшибок(КаталогСборкиПатча, Логирование = ПараметрыПроекта.Логирование)
    ;

    если не ИБВыгрузки == Неопределено
        попытка
            ИБВыгрузки.ВыгрузитьФайлыКонфигурации("Configuration.ParentConfigurations")
        поймать Исключение: Исключение
            пер ВыброситьИсключение = Истина
            если Исключение.Описание == "ОшибкаСтруктуры"
                если ФайлПоставщика.Размер == 0б
                    ПараметрыПроекта.Логирование.ВывестиСообщение("Необходимо передать конфигурацию поставщика в патч вручную\н")
                иначе
                    ВыброситьИсключение = Ложь
                ;
            ;
            если ВыброситьИсключение
                выбросить новый ИсключениеНедопустимоеСостояние(Исключение)
            ;
        ;
        знч ФайлИзменений = ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
        если не ФайлИзменений.Существует()
            ПараметрыПроекта.Логирование.ВывестиСообщение("\нКонфигурация не на поддержке")
            возврат Статус
        ;
        ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(
            IConfigurationProperties.РежимОбработки.ПолучитьПоПоддержке
        )
    ;

    ПрочитатьСтруктуруКонфигурации(
        ОсновнаяКонфигурация,
        КаталогСборкиПатча,
        Ложь,
        ИБВыгрузки == Неопределено ? Неопределено : ИБВыгрузки.Конфигурация.СтруктураКонфигурации.НастройкиПоддержки
    )

    пер ПутьКФайлуПоставщикаЗагрузки = ФайлПоставщика.Путь.Заменить(ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(), КаталогСборкиПатча.Путь)
    если не ИБВыгрузки == Неопределено и не ИБВыгрузки.Временная
        если не ФайлПоставщика.Существует() или ФайлПоставщика.Размер.ВБайтах() == 0
            ФайлПоставщика = ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьФайлПоставщика()
            ПутьКФайлуПоставщикаЗагрузки = ФайлПоставщика.Путь.Заменить(ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(), КаталогСборкиПатча.Путь)
        ;
        если ФайлПоставщика.Существует()
            Файлы.Скопировать(ФайлПоставщика, ПутьКФайлуПоставщикаЗагрузки)
        ;
    иначе
        // Для временных ИБ конфигурация поставщику занулим для скорости операций.
        // Также для ibsrv пока есть ошибки загрузки файлов с конфигурацией поставщика.
        (новый Файл(ПутьКФайлуПоставщикаЗагрузки)).ОткрытьПотокЗаписи().Записать(Байты{}).Закрыть()
    ;

    если не ИБВыгрузки == Неопределено
        oc_main.УдалитьФайлСКонтролемОшибок(ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации(), Логирование = ПараметрыПроекта.Логирование)
    ;

    знч Длительность = ПараметрыПроекта.Логирование.ЗавершитьЗамер("СобратьПатчКонфигурации")

    ФайлЗагрузкиПатча.ОткрытьПотокЗаписи().Записать(ОсновнаяКонфигурация.СтруктураКонфигурации.ТекстФайлыДляЗагрузки, Кодировка.Utf8).Закрыть()

    СобранныеПроекты.Добавить("%{КонфигурацияПатча.СтруктураКонфигурации.ПолучитьИмяКонфигурации()} (%{Длительность.Представление("с")} сек.)")
    ВывестиИнформациюПоПроектам(СобранныеПроекты, Логирование = ПараметрыПроекта.Логирование)

    ОсновнаяКонфигурация.АктуализироватьХеш()

    Статус = Истина

    возврат Статус

;

@Глобально
метод ПроверитьВерсиюИнформационнойБазы(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    возврат Истина

;

@Глобально
метод ПолучитьИзмененияПоследнейФиксации(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Массив<Строка>

    возврат новый Массив<Строка>()

;

@Глобально
метод ОбновитьКонфигурацию(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта, ТипЗагрузки = 1) : Булево

    пер Статус = Истина
    пер ИнформационныеБазы: Массив<IIBOperation.ИнформационнаяБаза>
    пер ТипОбновления = ""

    если ТипЗагрузки == 1
        Статус = СобратьКонфигурацию(ПараметрыПроекта)
        ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
        ТипОбновления = "ОбновитьКонфигурацию"
    иначе если ТипЗагрузки == 2
        ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
        ТипОбновления = "ОбновитьКонфигурациюИзФайлов"
    иначе если ТипЗагрузки == 3
        Статус = СобратьКонфигурацию(ПараметрыПроекта, Истина)
        ИнформационныеБазы = ПараметрыПроекта.ПолучитьИнформационныеБазыРасширений()
        ТипОбновления = "ОбновитьКонфигурацию"
     иначе если ТипЗагрузки == 4
        ИнформационныеБазы = ПараметрыПроекта.ПолучитьИнформационныеБазыРасширений()
        ТипОбновления = "ОбновитьКонфигурациюИзФайлов"
    иначе
        ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
        ТипОбновления = "ОбновитьПатчКонфигурации"
    ;

    если Статус
        для ИнформационнаяБаза из ИнформационныеБазы
            Статус = Статус и ОбновитьКонфигурациюИнформационнойБазы(ПараметрыПроекта, ИнформационнаяБаза, ТипОбновления)
        ;
    ;

    если Статус
        ВыполнитьПроверкуКонфигурации(ПараметрыПроекта, ТипЗагрузки == 3 или ТипЗагрузки == 4)
    ;

    возврат Статус
;

@Глобально
метод ВыполнитьПроверкуКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ПроверитьВсеРасширения = Ложь
    ) : Булево

    знч ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
    для ИнформационнаяБаза из ИнформационныеБазы
        ИнформационнаяБаза.ВыполнитьПроверкуКонфигурации(ПроверитьВсеРасширения)
    ;

    возврат Истина

;

@Глобально
метод ВыполнитьТестированиеИсправление(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    знч ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
    для ИнформационнаяБаза из ИнформационныеБазы
        ИнформационнаяБаза.ВыполнитьТестированиеИсправление()
    ;

    возврат Истина

;

@Глобально
метод ВыполнитьПроверкуАПК(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    возврат Истина

;

@Глобально
метод ПодготовитьКонфигурацию(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    пер СтатусВыполнения = Истина

    если ПараметрыПроекта.КонтекстИсполнения.РежимСборкиПроектаРасширения == IProjectProperties.РежимыСборкиПроекта.ВПустойКонфигурации
        возврат СтатусВыполнения
    ;

    ПараметрыПроекта.Логирование.НачатьЗамер("ПодготовитьКонфигурацию")

    знч ВременнаяИБ = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазу()
    //знч Версия = IConfiguration.ПрочитатьВерсиюКонфигурации(ОсновнаяКонфигурация.ПутьКФайламКонфигурации.Путь)

    пер СобратьКонфигурацию = Ложь
    если ВременнаяИБ.Пустая()
        СобратьКонфигурацию = Истина
    иначе
        если СобратьПатчКонфигурации(ПараметрыПроекта, ВременнаяИБ)
            ЗагрузитьПатчКонфигурации(ПараметрыПроекта, ВременнаяИБ)
        иначе
            СобратьКонфигурацию = Истина
        ;
    ;

    если СобратьКонфигурацию
        СтатусВыполнения = СтатусВыполнения и СобратьКонфигурацию(ПараметрыПроекта)
    ;

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПодготовитьКонфигурацию")

    возврат СтатусВыполнения

;

@Глобально
метод АнализироватьНастройкиПоддержки(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта, ИсправитьОшибки = Ложь) : Булево

    ПараметрыПроекта.Логирование.НачатьЗамер("АнализироватьНастройкиПоддержки")

    знч ОсновнаяКонфигурация    = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
    ОсновнаяКонфигурация.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(
        IConfigurationProperties.РежимОбработки.Основной
    )
    ОсновнаяКонфигурация.СтруктураКонфигурации.ИсправитьНастройкиПоддержки(ИсправитьОшибки)

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("АнализироватьНастройкиПоддержки")

    возврат Истина
;

@Глобально
метод АнализироватьНастройкиПоддержкиКонфигурацииПоставщика(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИсправитьОшибки = Ложь
    ) : Булево

    ПараметрыПроекта.Логирование.НачатьЗамер("АнализироватьНастройкиПоддержкиКонфигурацииПоставщика")

    ПолучитьФайлыКонфигурацииПоставщика(ПараметрыПроекта)

    знч КонфигурацияПоставщика = ПараметрыПроекта.ПолучитьКонфигурациюПоставщика()
    КонфигурацияПоставщика.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(
        IConfigurationProperties.РежимОбработки.Основной
    )
    КонфигурацияПоставщика.СтруктураКонфигурации.ИсправитьНастройкиПоддержки(ИсправитьОшибки)

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("АнализироватьНастройкиПоддержкиКонфигурацииПоставщика")

    возврат Истина
;

// Параметры:
//  ПараметрыПроекта
//  Конфигурация - Выгружаемая конфигурация
//
@Глобально
метод ПолучитьФайлыКонфигурацииХранилища(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        Конфигурация:     IIBOperationProperties.Конфигурация,
        ВерсияХранилища = ""
    ) : Булево

    ПараметрыПроекта.Логирование.НачатьЗамер("ПолучитьФайлыКонфигурации")

    знч ВременныеФайлы     = ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта
    знч ВременнаяИБ        = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазу(Конфигурация)

    ПодключитьВременнуюИнформационнуюБазуКХранилищуКонфигурации(ВременнаяИБ)
    если не ВерсияХранилища.Пусто()
        знч ФайлХранилища = Конфигурация.ПолучитьФайлХранилищаКонфигурации(ВременныеФайлы.Путь)
        ВременнаяИБ.ВыгрузитьКонфигурациюХранилищаКонфигурации(ФайлХранилища.Путь, ВерсияХранилища)
        знч ВременнаяИБУдалить = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазу(Конфигурация, "temp_del")
        ВременнаяИБУдалить.СоздатьИнформационнуюБазу()
        ВременнаяИБУдалить.ЗагрузитьКонфигурацию(ФайлХранилища.Путь)
        oc_main.УдалитьФайлСКонтролемОшибок(ФайлХранилища.Путь, Логирование = ПараметрыПроекта.Логирование)
        ПолучитьФайлыКонфигурации(ПараметрыПроекта, ВременнаяИБУдалить)
        ВременнаяИБУдалить.УдалитьИнформационнуюБазу()
    иначе
        ВременнаяИБ.ПолучитьИзмененияИзХранилищаКонфигурации("")
        ПолучитьФайлыКонфигурации(ПараметрыПроекта, ВременнаяИБ)
    ;

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлыКонфигурации")

    возврат Истина
;

// Параметры:
//  ПараметрыПроекта
//  ФайлыДляВыгрузки - Список файлов для выгрузки, разделенные запятыми
//
@Глобально
метод ПолучитьФайлыКонфигурацииПоставщика(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ФайлыДляВыгрузки = ""
    ) : Булево

    ПараметрыПроекта.Логирование.НачатьЗамер("ПолучитьФайлыКонфигурации")

    знч ОсновнаяКонфигурация = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
    знч ИнформационнаяБаза   = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазуПоставщика()
    знч ФайлConfigDumpInfo   = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьФайлConfigDumpInfo()

    если не ФайлыДляВыгрузки.Пусто() и ФайлConfigDumpInfo.Существует()
        возврат Истина
    ;

    знч ПутьКФайлуПоставщика = ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьФайлПоставщика()
    ИнформационнаяБаза.СоздатьИнформационнуюБазу()
    ИнформационнаяБаза.ЗагрузитьКонфигурацию(ПутьКФайлуПоставщика.Путь)
    oc_main.УдалитьФайлСКонтролемОшибок(
        ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации(),
        Логирование = ПараметрыПроекта.Логирование
    )
    ИнформационнаяБаза.ВыгрузитьФайлыКонфигурации(ФайлыДляВыгрузки)
    ИнформационнаяБаза.УдалитьИнформационнуюБазу()

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлыКонфигурации")

    возврат Истина
;

// Параметры:
//  ПараметрыПроекта
//  Конфигурация - Выгружаемая конфигурация
//  ФайлыДляВыгрузки - Список файлов для выгрузки, разделенные запятыми
//
@Глобально
метод ПолучитьФайлыКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза,
        ФайлыДляВыгрузки = ""
    ) : Булево

    ПараметрыПроекта.Логирование.НачатьЗамер("ПолучитьФайлыКонфигурации")

    знч КаталогФайловПроекта = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()

    если ИнформационнаяБаза.ПараметрыСоединения.СтрокаСоединения.Пусто()
        ПараметрыПроекта.Логирование.ВывестиСообщение("\нНе заполнен путь к ИБ в файле project_user_prop.json")
        возврат Ложь
    ;

    пер СтатусКонфигурации = 0
    если ФайлыДляВыгрузки.Пусто() и ИнформационнаяБаза.ФайлВерсийСуществует()
        // Выгрузка по файлу версии
        знч ПутьКФайлуСтатуса = oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь, ["Status.txt"])
        СтатусКонфигурации = ИнформационнаяБаза.ПолучитьСтатусКонфигурации(ПутьКФайлуСтатуса)
    иначе если не ФайлыДляВыгрузки.Пусто()
        // Частичная выгрузка
        СтатусКонфигурации = 1
    иначе если не ИнформационнаяБаза.ФайлВерсийСуществует()
        // Полная выгрузка
        СтатусКонфигурации = 2
    ;

    если СтатусКонфигурации == 0
        ПараметрыПроекта.Логирование.ВывестиСообщение("\нИзменений нет")
        ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлыКонфигурации")
        возврат Истина
    ;

    знч ИБВыгрузки =
        СтатусКонфигурации == 2
        ? ИнформационнаяБаза
        : ПараметрыПроекта.ПолучитьИнформационнуюБазуВыгрузки(
            ИнформационнаяБаза,
            oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь, ["temp_xml"])
        )
    ИБВыгрузки.ВыгрузитьФайлыКонфигурации(ФайлыДляВыгрузки, СтатусКонфигурации == 2)

    знч КаталогВыгрузки = ИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    если СтатусКонфигурации == 1 и КаталогВыгрузки.Дочерние.Размер() > 0

        знч НастройкиПоиска = новый НастройкиПоискаФайлов()
            .ИсключитьКаталоги(Истина)
            .ИсключитьСсылки(Истина)
        знч НайденныеФайлы = Файлы.Найти(КаталогВыгрузки, НастройкиПоиска)

        ПараметрыПроекта.Логирование.ВывестиСообщение("\нПолучены изменения:")
        ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(
            IConfigurationProperties.РежимОбработки.ПолучитьПоПоддержке
        )
        знч ФайлВерсийПроекта = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьФайлConfigDumpInfo()
        если ИБВыгрузки.ФайлВерсийСуществует()
            Файлы.Скопировать(ИБВыгрузки.ФайлВерсий, ФайлВерсийПроекта)
        ;
        знч ПредыдущиеИдентификаторы = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.Идентификаторы.ВСоответствие(
            КлючИЗначение -> КлючИЗначение.Ключ,
            КлючИЗначение -> КлючИЗначение.Значение
        )
        ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(
            IConfigurationProperties.РежимОбработки.ПолучитьПоПоддержке
        )
        
        пер УдаленыФайлы = Ложь
        для ОбъектМетаданных из ПредыдущиеИдентификаторы
            знч ОбъектСуществует = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.Идентификаторы.СодержитКлюч(ОбъектМетаданных.Ключ)
            если не ОбъектСуществует и ОбъектМетаданных.Значение.Файлы.Размер() > 0
                oc_main.УдалитьФайлСКонтролемОшибок(
                    ОбъектМетаданных.Значение.Файлы["ПутьКОсновномуФайлу"],
                    Логирование = ПараметрыПроекта.Логирование
                )
                oc_main.УдалитьФайлСКонтролемОшибок(
                    ОбъектМетаданных.Значение.Файлы["ПутьКОсновномуКаталогу"],
                    Логирование = ПараметрыПроекта.Логирование
                )
                УдаленыФайлы = Истина
            ;
        ;
        если УдаленыФайлы
            ПараметрыПроекта.Логирование.ВывестиСообщение("\н")
        ;
        ПредыдущиеИдентификаторы.Очистить()

        для ФайлИсточник из НайденныеФайлы
            если ФайлИсточник.ИмяБезРасширения == "ConfigDumpInfo"
                продолжить
            ;
            знч ФайлЦель = новый Файл(
                oc_main.ДобавитьЧастьПути(
                    КаталогФайловПроекта.Путь,
                    [oc_main.УдалитьЧастьПути(ФайлИсточник.Путь, [КаталогВыгрузки.Путь])]
                )
            )
            знч НастройкиКопированияФайлов = новый НастройкиКопированияФайлов()
            Файлы.Переместить(ФайлИсточник, ФайлЦель, НастройкиКопированияФайлов)
            ПараметрыПроекта.Логирование.ВывестиСообщение(ФайлЦель.Путь)
        ;
        ПараметрыПроекта.Логирование.ВывестиСообщение("\нКаталог файлов конфигурации обновлен")

    ;

    если не КаталогВыгрузки == КаталогФайловПроекта
        oc_main.УдалитьФайлСКонтролемОшибок(КаталогВыгрузки, Логирование = ПараметрыПроекта.Логирование)
    ;

    ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПеревестиВНовыйФорматParentConfigurations()
    ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПеревестиВНовыйФорматConfigDumpInfo()

    ПараметрыПроекта.Логирование.ЗавершитьЗамер("ПолучитьФайлыКонфигурации")

    возврат Истина
;

@Глобально
метод ОбновитьИнформационнуюБазу(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    знч ИнформационныеБазыДляОбновления = новый Соответствие<Строка, Массив<IIBOperation.ИнформационнаяБаза>>()
    
    знч ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
    для ИнформационнаяБаза из ИнформационныеБазы
        знч ИнформационныеБазыПоИмени = ИнформационныеБазыДляОбновления.ПолучитьИлиУмолчание(ИнформационнаяБаза.ПараметрыСоединения.Имя, новый Массив<IIBOperation.ИнформационнаяБаза>())
        ИнформационныеБазыПоИмени.Добавить(ИнформационнаяБаза)
        ИнформационныеБазыДляОбновления.Вставить(ИнформационнаяБаза.ПараметрыСоединения.Имя, ИнформационныеБазыПоИмени)
    ;

    знч Расширения = ПараметрыПроекта.ПолучитьРасширения()
    для Расширение из Расширения
        знч ИнформационныеБазыРасширения = ПараметрыПроекта.ПолучитьИнформационныеБазыКонфигурации(Расширение)
        для ИнформационнаяБазаРасширения из ИнформационныеБазыРасширения
            знч ИнформационныеБазыПоИмени = ИнформационныеБазыДляОбновления.ПолучитьИлиУмолчание(ИнформационнаяБазаРасширения.ПараметрыСоединения.Имя, новый Массив<IIBOperation.ИнформационнаяБаза>())
            ИнформационныеБазыПоИмени.Добавить(ИнформационнаяБазаРасширения)
            ИнформационныеБазыДляОбновления.Вставить(ИнформационнаяБазаРасширения.ПараметрыСоединения.Имя, ИнформационныеБазыПоИмени)
        ;
    ;
    
    для ИнформационныеБазыПоИмени из ИнформационныеБазыДляОбновления
        пер ИндексИБ = 0
        для ИнформационнаяБаза из ИнформационныеБазыПоИмени.Значение
            если ИндексИБ == 0
                ИнформационнаяБаза.ПодготовитьИнформационнуюБазуКОбновлению()
            ;
            ИнформационнаяБаза.ОбновитьИнформационнуюБазу()
            ИндексИБ = ИндексИБ + 1
            если ИндексИБ > 0
                ИнформационнаяБаза.ВыполнитьПроверкуПримененияРасширений()
            ;
            если ИндексИБ == ИнформационныеБазыПоИмени.Значение.Размер()
                если ИндексИБ > 0
                    ИнформационнаяБаза.ВыполнитьПроверкуПримененияРасширений(Истина)
                ;
                ИнформационнаяБаза.РазблокироватьИнформационнуюБазу()
            ;
        ;
    ;

    возврат Истина

;

@Глобально
метод ВыгрузитьИнформационнуюБазу(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    знч ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()
    для ИнформационнаяБаза из ИнформационныеБазы
        ИнформационнаяБаза.ВыгрузитьИнформационнуюБазу()
    ;

    возврат Истина
;

@Глобально
метод СкопироватьИнформационнуюБазу(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    знч ИнформационныеБазы = ПараметрыПроекта.ПолучитьОсновныеИнформационныеБазы()

    если ИнформационныеБазы.Размер() != 2
        ПараметрыПроекта.Логирование.ВывестиСообщение("\нДолжно быть указано две информационные базы через запятую: ИБИсточник, ИБПриемник")
        возврат Ложь
    ;
    знч ПутьКФайлуВыгрузки = oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь, [ "temp.dt" ])
    ИнформационныеБазы[0].ВыгрузитьИнформационнуюБазу(ПутьКФайлуВыгрузки)
    ИнформационныеБазы[1].ЗагрузитьИнформационнуюБазу(ПутьКФайлуВыгрузки)
    Файлы.Удалить(ПутьКФайлуВыгрузки)

    возврат Истина
;

@Глобально
метод ПолучитьСтатусКонфигурации(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    знч ПутьКФайлуСтатуса  = oc_main.ДобавитьЧастьПути(
        ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь,
        ["Status.txt"]
    )
    знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьОсновнуюИнформационнуюБазу()
    ИнформационнаяБаза.ПолучитьСтатусКонфигурации(ПутьКФайлуСтатуса)

    возврат Истина

;

@Глобально
метод СинхронизироватьХранилищеКонфигурацийСGitХранилищем(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    если не ПараметрыПроекта.ПараметрыGit.Используется
        возврат Истина
    ;

    ПараметрыПроекта.ОбновитьИзGit()

    знч ДанныеХранилищКонфигураций = новый Массив<Соответствие<Строка, Объект?>>()
    для Конфигурация из ПараметрыПроекта.Конфигурации
        если не Конфигурация.Значение.ПараметрыХранилища.Используется
            продолжить
        ;
        знч ДанныеХранилищаКонфигурации = ПолучитьДанныеХранилищаКонфигурации(ПараметрыПроекта, Конфигурация.Значение)
        если (ДанныеХранилищаКонфигурации["ИмеютсяРазличия"] как Булево)
            ДанныеХранилищаКонфигурации.Вставить("Конфигурация", Конфигурация.Значение)
            ДанныеХранилищКонфигураций.Добавить(ДанныеХранилищаКонфигурации)
        ;
    ;

    если ДанныеХранилищКонфигураций.Размер() == 0
        возврат Истина
    ;

    для ДанныеХранилища из ДанныеХранилищКонфигураций
        знч Конфигурация = ДанныеХранилища["Конфигурация"] как IIBOperationProperties.Конфигурация
        СинхронизироватьХранилищеКонфигурацииСGitХранилищем(ПараметрыПроекта, Конфигурация, ДанныеХранилища)
    ;

    ПараметрыПроекта.Обновить()

    возврат Истина

;

@Глобально
метод ПоместитьИзмененияКонфигурацийВGitХранилище(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта) : Булево

    если не ПараметрыПроекта.ПараметрыGit.Используется
        возврат Истина
    ;

    пер ИмяВетки = ПараметрыПроекта.ПараметрыGit.ПолучитьИмяТекущейВеткиХранилища()
    если ИмяВетки == ПараметрыПроекта.ПараметрыGit.ОсновнаяВетка
        ИмяВетки ="CodeReview_%{ДатаВремя.Сейчас().Представление("дд_ММ_гггг_ЧЧ_мм_сс")}"
    ;
    знч ИмяНовойВеткиРучнойВвод = Консоль.СчитатьСтроку("Имя ветки (%{ИмяВетки}):")
    если не ИмяНовойВеткиРучнойВвод.Пусто()
        ИмяВетки = ИмяНовойВеткиРучнойВвод
    ;
    знч КомментарийХранилища = Консоль.СчитатьСтроку("Комментарий хранилища:")

    ПараметрыПроекта.ОбновитьИзGit()
    знч ДанныеХранилищКонфигураций = новый Массив<Соответствие<Строка, Объект?>>()
    для Конфигурация из ПараметрыПроекта.Конфигурации
        если не Конфигурация.Значение.ПараметрыХранилища.Используется
            продолжить
        ;
        знч ДанныеХранилищаКонфигурации = ПолучитьДанныеХранилищаКонфигурации(ПараметрыПроекта, Конфигурация.Значение)
        если (ДанныеХранилищаКонфигурации["ИмеютсяРазличия"] как Булево)
            ДанныеХранилищаКонфигурации.Вставить("Конфигурация", Конфигурация.Значение)
            ДанныеХранилищКонфигураций.Добавить(ДанныеХранилищаКонфигурации)
        ;
    ;
    ПараметрыПроекта.Обновить()
    пер СтатусВыполнения = Истина

    если ИмяНовойВеткиРучнойВвод.Пусто() и ДанныеХранилищКонфигураций.Размер() > 0
        ИмяВетки ="CodeReview_%{ДатаВремя.Сейчас().Представление("дд_ММ_гггг_ЧЧ_мм_сс")}"
    ;

    для ДанныеХранилища из ДанныеХранилищКонфигураций
        знч Конфигурация = ДанныеХранилища["Конфигурация"] как IIBOperationProperties.Конфигурация
        СтатусВыполнения = СтатусВыполнения и СинхронизироватьХранилищеКонфигурацииСGitХранилищем(ПараметрыПроекта, Конфигурация, ДанныеХранилища)
    ;

    ПерейтиНаВеткуGitХранилища(ПараметрыПроекта, ИмяВетки, Ложь, Истина)

    для Конфигурация из ПараметрыПроекта.Конфигурации
        если не Конфигурация.Значение.ПараметрыХранилища.Используется
            продолжить
        ;
        знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьИнформационнуюБазуКонфигурации(Конфигурация.Значение)
        СтатусВыполнения = СтатусВыполнения и ПолучитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
    ;

    если не КомментарийХранилища.Пусто()
        СтатусВыполнения = СтатусВыполнения и ЗафиксироватьИзмененияВGitХранилище(ПараметрыПроекта, ИмяВетки, КомментарийХранилища)
    иначе
        СтатусВыполнения = Ложь
        ПараметрыПроекта.Логирование.ВывестиСообщение("\нНе введен комментарий хранилища")
    ;

    возврат Истина

;

// СлужебныеПроцедурыИФункции

@Локально
метод ПрочитатьСтруктуруКонфигурации(
        Конфигурация: IIBOperationProperties.Конфигурация,
        КаталогСборкиПатча: Файл?,
        ИсправитьОшибки = Ложь,
        НастройкиПоддержкиИБ: IConfigurationProperties.НастройкиПоддержки? = Неопределено
    )

    знч РежимОбработки = IConfigurationProperties.РежимОбработки.ПолучитьПоПоддержке
    Конфигурация.СтруктураКонфигурации.ИнициализироватьСтруктуруКонфигурации(РежимОбработки, НастройкиПоддержкиИБ)
    Конфигурация.СтруктураКонфигурации.ИсправитьНастройкиПоддержки(ИсправитьОшибки)
    Конфигурация.СтруктураКонфигурации.ОбработатьФайлыКонфигурации(КаталогСборкиПатча, РежимОбработки)

;

@Локально
метод ПолучитьФайлКонфигурации(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта, Конфигурация: IIBOperationProperties.Конфигурация, ПересобратьКонфигурациюПоставщика: Булево = Ложь): Число

    пер Результат = 0
    знч ФайлыПроекта = Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    знч ФайлКонфигурации = Конфигурация.ПолучитьФайлКонфигурации(ПараметрыПроекта.КонтекстИсполнения.ПутьКСборкеПроекта.ФайлыПроекта.Путь)

    ПрочитатьСтруктуруКонфигурации(
        Конфигурация,
        Неопределено,
        ПересобратьКонфигурациюПоставщика
    )
    знч ВременнаяИБ = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазу(Конфигурация)
    знч ВременнаяИБВыгрузки = ПараметрыПроекта.ПолучитьИнформационнуюБазуВыгрузки(
        ВременнаяИБ,
        oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь, ["temp_xml"])
    )
    знч КаталогВыгрузки = ВременнаяИБВыгрузки.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    oc_main.УдалитьФайлСКонтролемОшибок(КаталогВыгрузки, Логирование = ПараметрыПроекта.Логирование)
    знч КаталогКонфигурации = Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    //знч ОсновнаяВерсия       = IConfiguration.ПрочитатьВерсиюКонфигурации(ОсновнаяКонфигурация.ПутьКФайламКонфигурации.Путь)

    знч ФайлКонфигурацииПоставщика  = Конфигурация.СтруктураКонфигурации.ПолучитьФайлПоставщика()

    если не ПересобратьКонфигурациюПоставщика
        и Конфигурация.ХешАктуальный()
        и ФайлКонфигурации.Существует()
        и не ВременнаяИБ.Пустая()
        ПараметрыПроекта.Логирование.ВывестиСообщение("\н%{Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()}: изменений нет")
        возврат Результат
    ;

    попытка

        если ПересобратьКонфигурациюПоставщика

            знч ИБПоставщика = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазуПоставщика()
            ИБПоставщика.УдалитьИнформационнуюБазу()

            знч ФайлыПоставщика = ИБПоставщика.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
            oc_main.УдалитьФайлСКонтролемОшибок(ФайлыПоставщика, Логирование = ПараметрыПроекта.Логирование)

            ИБПоставщика.СоздатьИнформационнуюБазу()
            ИБПоставщика.ЗагрузитьКонфигурацию(ФайлКонфигурацииПоставщика.Путь)
            ИБПоставщика.ВыгрузитьФайлыКонфигурации()
            ИБПоставщика.УдалитьИнформационнуюБазу()
            ИБПоставщика.СоздатьИнформационнуюБазу()
            ИБПоставщика.ЗагрузитьФайлыКонфигурации()

            Конфигурация.СтруктураКонфигурации.ОбработатьФайлыКонфигурации(
                ФайлыПоставщика,
                IConfigurationProperties.РежимОбработки.ПолучитьПоПоддержке
            )
            ПараметрыПроекта.Логирование.ВывестиСообщение("\нВ \"%{ФайлыПроекта.Путь}\" добавлены измененные файлы из основной конфигурации")
            Файлы.СоздатьКаталог(oc_main.ДобавитьЧастьПути(ФайлыПоставщика.Путь, ["Ext","ParentConfigurations"]))

            ИБПоставщика.ВыгрузитьКонфигурацию(
                oc_main.ДобавитьЧастьПути(ФайлыПоставщика.Путь, ["Ext","ParentConfigurations", ФайлКонфигурацииПоставщика.Имя])
            )
            ИБПоставщика.УдалитьИнформационнуюБазу()
            oc_main.УдалитьФайлСКонтролемОшибок(ФайлыПроекта, Истина, ПараметрыПроекта.Логирование)
            Файлы.Скопировать(ФайлыПоставщика, ФайлыПроекта)

            ПараметрыПроекта.Логирование.ВывестиСообщение("\нПеренесены изменения из \"%{ФайлыПоставщика.Путь}\" в основную конфигурацию")

            oc_main.УдалитьФайлСКонтролемОшибок(ФайлыПоставщика, Логирование = ПараметрыПроекта.Логирование)
        ;

        если не Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            ВременнаяИБ.УдалитьИнформационнуюБазу()
            ВременнаяИБ.СоздатьИнформационнуюБазу()
        иначе
            ВременнаяИБ.УдалитьФайлВерсий()
        ;

        Конфигурация.АктуализироватьХеш()

        пер МаксимальноеЧислоПопыток  = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? 4 : 2
        пер ХешАктуализированПовторно = Ложь

        для ЧислоПопыток = 1 по МаксимальноеЧислоПопыток

            ВременнаяИБ.ЗагрузитьФайлыКонфигурации()
            // Сделана выгрузка во временный каталог с последующим перемещением файлов, для избежания ошибок очистки каталога проекта
            ВременнаяИБВыгрузки.ВыгрузитьФайлыКонфигурации()
            oc_main.УдалитьФайлСКонтролемОшибок(КаталогКонфигурации, Истина, ПараметрыПроекта.Логирование)
            ВременнаяИБ.УдалитьФайлВерсий()
            Файлы.Переместить(КаталогВыгрузки, КаталогКонфигурации)

            ПрочитатьСтруктуруКонфигурации(Конфигурация, Неопределено)
            ХешАктуализированПовторно = Конфигурация.АктуализироватьХеш()
            если ХешАктуализированПовторно и ЧислоПопыток < МаксимальноеЧислоПопыток
                ПараметрыПроекта.Логирование.ВывестиСообщение("\н*****************************************************************")
                ПараметрыПроекта.Логирование.ВывестиСообщение("Повторная выгрузка репозитория")
                ПараметрыПроекта.Логирование.ВывестиСообщение("*****************************************************************")
            иначе
                прервать
            ;

        ;

        если Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            и ХешАктуализированПовторно
            выбросить новый ИсключениеНедопустимоеСостояние("Ошибка выгрузки проекта")
        ;

        ВременнаяИБ.ВыгрузитьКонфигурацию(ФайлКонфигурации.Путь)
        ВременнаяИБ.АктуализироватьХеш()

        если ПересобратьКонфигурациюПоставщика
            ВременнаяИБ.СравнитьКонфигурации(
                oc_main.ДобавитьЧастьПути(
                    ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь,
                    ["ИзмененияВКонфигурации_prod.mxl"]
                ),
                oc_main.РежимыСравнения.СравнитьСКонфигурациейПоставщика,
                ФайлКонфигурацииПоставщика.ИмяБезРасширения
            )
        ;

        Результат = 1
        ПараметрыПроекта.ДобавитьХеш(ВременнаяИБ)
        ПараметрыПроекта.ДобавитьХеш(Конфигурация)

    поймать Исключение: Исключение
        если не Исключение.Описание.Пусто()
            ПараметрыПроекта.Логирование.ВывестиСообщение("\н#################################################################")
            ПараметрыПроекта.Логирование.ВывестиСообщение(Исключение.Информация())
            ПараметрыПроекта.Логирование.ВывестиСообщение("#################################################################")
        ;
        Результат = 2
    ;

    oc_main.УдалитьФайлСКонтролемОшибок(КаталогВыгрузки, Логирование = ПараметрыПроекта.Логирование)
    если ПараметрыПроекта.КонтекстИсполнения.РежимСборкиПроектаРасширения == IProjectProperties.РежимыСборкиПроекта.ВПустойКонфигурации
        ВременнаяИБ.УдалитьИнформационнуюБазу()
    ;

    возврат Результат
;

@Локально
метод ОбновитьФайлВерсииКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза,
        АктуальностьФайлаВерсий: Момент
    )

    если ИнформационнаяБаза.ФайлВерсийТребуетОбновления(АктуальностьФайлаВерсий)
        ПолучитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза, "ConfigDumpInfo.xml")
    иначе
        ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПеревестиВНовыйФорматConfigDumpInfo()
    ;
;

@Локально
метод ОбновитьКонфигурациюИнформационнойБазы(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза,
        ТипОбновления: Строка,
        ПолучитьФайлСравнения = Ложь
    ) : Булево

    пер Статус = Ложь

    ПараметрыПроекта.Логирование.НачатьЗамер(ТипОбновления)

    знч АктуальностьФайлаВерсий = ИнформационнаяБаза.ПолучитьАктуальностьФайлаВерсий()

    если ИнформационнаяБаза.Пустая()
        ИнформационнаяБаза.СоздатьИнформационнуюБазу()
    ;
    если ТипОбновления == "ОбновитьКонфигурацию"
        Статус = ЗагрузитьКонфигурацию(ПараметрыПроекта, ИнформационнаяБаза)
    иначе если ТипОбновления == "ОбновитьКонфигурациюИзФайлов"
        Статус = ЗагрузитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
     иначе если ТипОбновления == "ОбновитьПатчКонфигурации"
        если СобратьПатчКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
            Статус = ЗагрузитьПатчКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
        ;
    ;
    если Статус
        и ИнформационнаяБаза.ПараметрыСоединения.ВедетсяРазработка
        и ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ФайлыКонфигурацииСуществуют()
        ОбновитьФайлВерсииКонфигурации(ПараметрыПроекта, ИнформационнаяБаза, АктуальностьФайлаВерсий)
    ;
    если Статус и ПолучитьФайлСравнения
        ИнформационнаяБаза.СравнитьКонфигурации(
            oc_main.ДобавитьЧастьПути(
                ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь,
                ["ИзмененияВКонфигурации.mxl"]
            ),
            oc_main.РежимыСравнения.СравнитьСКонфигурациейИБ
        )
    ;
    ПараметрыПроекта.Логирование.ЗавершитьЗамер(ТипОбновления)

    возврат Статус

;

@Локально
метод ЗагрузитьКонфигурацию(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза
    ) : Булево

    знч ФайлКонфигурации = ИнформационнаяБаза.Конфигурация.ПолучитьФайлКонфигурации(ПараметрыПроекта.КонтекстИсполнения.ПутьКСборкеПроекта.ФайлыПроекта.Путь)
    если не ФайлКонфигурации.Существует()
        ПараметрыПроекта.Логирование.ВывестиСообщение("Не существует файла загрузки %{ФайлКонфигурации.Путь}")
        возврат Ложь
    ;

    если ИнформационнаяБаза.ХешАктуальный()
        если ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            ПараметрыПроекта.Логирование.ВывестиСообщение("Расширение %{ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()} информационной базы актуально")
        иначе
            ПараметрыПроекта.Логирование.ВывестиСообщение("Конфигурация информационной базы актуальна")
        ;
        возврат Ложь
    ;

    ИнформационнаяБаза.ЗагрузитьКонфигурацию(ФайлКонфигурации.Путь)

    ИнформационнаяБаза.АктуализироватьХеш()
    ПараметрыПроекта.ДобавитьХеш(ИнформационнаяБаза)

    возврат Истина

;

@Локально
метод ЗагрузитьФайлыКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза
    ) : Булево

    знч ФайлыЗагрузки = ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()

    если не ФайлыЗагрузки.Существует()
        ПараметрыПроекта.Логирование.ВывестиСообщение("Не существует файлов загрузки %{ФайлыЗагрузки.Путь}")
        возврат Ложь
    ;

    пер ФайлыДляЗагрузки: Строка|Файл = новый Файл(
        oc_main.ДобавитьЧастьПути(
            ПараметрыПроекта.КонтекстИсполнения.ПутьКСборкеПроекта.ФайлыПроекта.Путь,
            ["%{ФайлыЗагрузки.ИмяБезРасширения}_in"]
        )
    )
    если не (ФайлыДляЗагрузки как Файл).Существует()
        ФайлыДляЗагрузки = ""
    ;

    если ФайлыДляЗагрузки == "" и ИнформационнаяБаза.ХешАктуальный()
        если ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            ПараметрыПроекта.Логирование.ВывестиСообщение("Расширение %{ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()} информационной базы актуально")
        иначе
            ПараметрыПроекта.Логирование.ВывестиСообщение("Конфигурация информационной базы актуальна")
        ;
        возврат Ложь
    ;

    ИнформационнаяБаза.ЗагрузитьФайлыКонфигурации(ФайлыДляЗагрузки)

    если ФайлыДляЗагрузки == ""
        ИнформационнаяБаза.АктуализироватьХеш()
        ПараметрыПроекта.ДобавитьХеш(ИнформационнаяБаза)
    ;

    возврат Истина

;

@Локально
метод ЗагрузитьПатчКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза
    ) : Булево

    если ИнформационнаяБаза.ХешАктуальный()
        ПараметрыПроекта.Логирование.ВывестиСообщение("Конфигурация информационной базы актуальна")
        возврат Ложь
    ;

    знч КонфигурацияПатча = ПараметрыПроекта.ПолучитьКонфигурациюПатча()
    знч КаталогСборкиПатча = КонфигурацияПатча.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()
    знч ФайлЗагрузкиПатча  = новый Файл("%{КаталогСборкиПатча.Путь}_in")

    если не КонфигурацияПатча.СтруктураКонфигурации.ФайлыКонфигурацииСуществуют()
        или не ФайлЗагрузкиПатча.Существует()
        возврат Ложь
    ;

    знч ФайлПоставщика = КонфигурацияПатча.СтруктураКонфигурации.ПолучитьФайлПоставщика()
    знч ФайлParentConfigurations = КонфигурацияПатча.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
    если не ИнформационнаяБаза.Временная
        и ФайлParentConfigurations.Существует()
        и (не ФайлПоставщика.Существует() или ФайлПоставщика.Размер == 0б)
        знч текстОшибки = "Не задан файл конфигурации поставщика"
        выбросить новый ИсключениеНедопустимоеСостояние(текстОшибки)
    ;
    
    знч ИнформационнаяБазаПатча = ПараметрыПроекта.ПолучитьИнформационнуюБазуКонфигурации(КонфигурацияПатча, ИнформационнаяБаза.ПараметрыСоединения)
    ИнформационнаяБазаПатча.ЗагрузитьФайлыКонфигурации(ФайлЗагрузкиПатча)
    КонфигурацияПатча.СтруктураКонфигурации.СброситьФайлПоставщика()

    ИнформационнаяБаза.АктуализироватьХеш()
    ПараметрыПроекта.ДобавитьХеш(ИнформационнаяБаза)

    возврат Истина

;

@Локально
метод ПодключитьВременнуюИнформационнуюБазуКХранилищуКонфигурации(ИнформационнаяБаза: IIBOperation.ИнформационнаяБаза)
    
    если ИнформационнаяБаза.Пустая()
        ИнформационнаяБаза.СоздатьИнформационнуюБазу()
    ;
    если ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
        и не ИнформационнаяБаза.ПроверитьНаличиеРасширения(ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации())
        ИнформационнаяБаза.СоздатьРасширение(ИнформационнаяБаза.Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации())
    ;
    ИнформационнаяБаза.ПодключитьсяКХранилищуКонфигурации()

;

@Локально
метод ПолучитьДанныеХранилищаКонфигурации(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        Конфигурация: IIBOperationProperties.Конфигурация
    ) : Соответствие<Строка, Объект?>

    знч ПутьКФайлуОтчета   = oc_main.ДобавитьЧастьПути(
        ПараметрыПроекта.КонтекстИсполнения.ПутьКВременнымФайлам.ФайлыПроекта.Путь,
        ["Report.txt"]
    )
    знч ВременнаяИБ     = ПараметрыПроекта.ПолучитьВременнуюИнформационнуюБазу(Конфигурация)
    ПодключитьВременнуюИнформационнуюБазуКХранилищуКонфигурации(ВременнаяИБ)
    знч ДанныеХранилища = ВременнаяИБ.ПолучитьДанныеХранилищаКонфигурации(ПутьКФайлуОтчета)

    ДанныеХранилища.Вставить("ИмеютсяРазличия", не Конфигурация.ПараметрыХранилища.ТекущийНомерВерсии == ДанныеХранилища["НомерВерсии"])

    возврат ДанныеХранилища

;

@Локально
метод СинхронизироватьХранилищеКонфигурацииСGitХранилищем(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        Конфигурация: IIBOperationProperties.Конфигурация,
        ДанныеХранилища: Соответствие<Строка, Объект?>|Неопределено = Неопределено
    ) : Булево

    ПерейтиНаВеткуGitХранилища(ПараметрыПроекта, "", Истина)

    ПолучитьФайлыКонфигурацииХранилища(ПараметрыПроекта, Конфигурация)

    если не Конфигурация.ПараметрыХранилища.ТекущийНомерВерсии == (ДанныеХранилища["НомерВерсии"] как Строка)
        Конфигурация.ПараметрыХранилища.ТекущийНомерВерсии = (ДанныеХранилища["НомерВерсии"] как Строка)
        ПараметрыПроекта.ЗаписатьНастройки()
    ;
    пер Комментарий = (ДанныеХранилища["Комментарий"] как Строка)
    если Комментарий.Пусто()
        Комментарий = "Фиксация версии %{(ДанныеХранилища["НомерВерсии"] как Строка)} хранилища 1С"
        + (
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            ? " расширения %{Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()}"
            : ""
        )
    ;
    ЗафиксироватьИзмененияВGitХранилище(
        ПараметрыПроекта,
        "",
        Комментарий,
        ДанныеХранилища.ПолучитьИлиУмолчание("Автор", "") как Строка
    )

    знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьИнформационнуюБазуКонфигурации(Конфигурация)
    ИнформационнаяБаза.ПолучитьИзмененияИзХранилищаКонфигурации("")

    возврат Истина

;

@Локально
метод ПерейтиНаВеткуGitХранилища(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИмяВетки = "",
        ПерейтиНаВнешнююВетку = Ложь,
        СоздатьВеткуХранилища = Ложь
    )

    пер ВеткаСуществует = Ложь

    если ПерейтиНаВнешнююВетку
        ВеткаСуществует = ПараметрыПроекта.ПараметрыGit.ПерейтиНаВеткуВнешнегоХранилища(ИмяВетки)
    иначе
        ВеткаСуществует = ПараметрыПроекта.ПараметрыGit.ПерейтиНаВеткуХранилища(ИмяВетки)
    ;

    если не ВеткаСуществует и СоздатьВеткуХранилища
        ПараметрыПроекта.ПараметрыGit.СоздатьВеткуХранилища(ИмяВетки)
    ;

    ПараметрыПроекта.Обновить()

;

@Локально
метод ЗафиксироватьИзмененияВGitХранилище(
        ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
        ИмяВетки: Строка,
        КомментарийХранилища: Строка,
        АвторХранилища = ""
    ) : Булево

    если ПараметрыПроекта.ПараметрыGit.ИмеютсяИзмененияВХранилище()
        ПараметрыПроекта.ПараметрыGit.ЗафиксироватьИзмененияВХранилище(
            КомментарийХранилища,
            АвторХранилища
        )
        ПараметрыПроекта.ПараметрыGit.ОтправитьИзмененияВоВнешнееХранилище(ИмяВетки)
    ;

    возврат Истина

;

@Локально
метод ВывестиИнформациюПоПроектам(Проекты: Массив<Строка>, СтатусСборки = 1, Логирование: ILogging.Логирование)

    если не Проекты.Пусто() и СтатусСборки == 1
        Логирование.ВывестиСообщение("\нСобранные проекты:")
    иначе если не Проекты.Пусто() и СтатусСборки == 2
        Логирование.ВывестиСообщение("\н##################")
        Логирование.ВывестиСообщение("\нОшибочные проекты:")
    ;

    для ИмяПроекта из Проекты
        Логирование.ВывестиСообщение(ИмяПроекта)
    ;

;