#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl

// ПрограммныйИнтерфейс

@Глобально
метод Инициализировать(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    ПолучитьИнформациюОбАгенте(ПараметрыСоединения)
    ПолучитьИнформациюОКластере(ПараметрыСоединения)
    ПолучитьИнформациюОбИнформационнойБазе(ПараметрыСоединения)

;

@Глобально
метод ЗаблокироватьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("update")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--permission-code",     ПараметрыСоединения.КодРазрешения, Истина)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--sessions-deny",       "on")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--scheduled-jobs-deny", "on")
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод РазблокироватьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("update")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--sessions-deny",       "off")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--scheduled-jobs-deny", "off")
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ЗавершитьСоединенияИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): Булево

    пер ПодождатьМинуту = Ложь
    пер БылиЗавершения  = Ложь

    знч ДанныеСеансов = ПолучитьСеансыИнформационнойБазы(ПараметрыСоединения)
    для ДанныеСеанса из ДанныеСеансов
        если (не НеБлокирующиеПриложения().Содержит(ДанныеСеанса.Получить("app-id") как Строка))
            ЗавершитьСеансИнформационнойБазы(ПараметрыСоединения, ДанныеСеанса.Получить("session") как Строка)
            ПодождатьМинуту = Истина
            БылиЗавершения  = Истина
        ;
    ;

    если ПодождатьМинуту
        Пауза(1м)
        ПодождатьМинуту = Ложь
    ;

    знч ДанныеСоединений = ПолучитьСоединенияИнформационнойБазы(ПараметрыСоединения)

    для ДанныеСоединения из ДанныеСоединений
        если (не НеБлокирующиеПриложения().Содержит(ДанныеСоединения.Получить("application") как Строка))
             и (ДанныеСоединения.Получить("conn-id") как Число) > 0
            ЗавершитьСоединениеИнформационнойБазы(ПараметрыСоединения, ДанныеСоединения.Получить("connection") как Строка, ДанныеСоединения.Получить("process") как Строка)
            ПодождатьМинуту = Истина
            БылиЗавершения  = Истина
        ;
    ;

    если ПодождатьМинуту
        Пауза(1м)
    ;

    возврат БылиЗавершения

;

@Глобально
метод ПроверитьАктивныеСоединенияИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): Булево

    пер ЕстьАктивныеСоединения = Ложь
    знч ДанныеСеансов = ПолучитьСеансыИнформационнойБазы(ПараметрыСоединения)

    для ДанныеСеанса из ДанныеСеансов
        если (не НеБлокирующиеПриложения().Содержит(ДанныеСеанса.Получить("app-id") как Строка))
            Консоль.Записать("Сеанс %{ДанныеСеанса.Получить("session-id")} (%{ДанныеСеанса.Получить("last-active-at")}): %{ДанныеСеанса.Получить("host")} %{ДанныеСеанса.Получить("user-name")}  %{ДанныеСеанса.Получить("app-id")}\н")
            ЕстьАктивныеСоединения = Истина
        ;
    ;

    знч ДанныеСоединений = ПолучитьСоединенияИнформационнойБазы(ПараметрыСоединения)

    для ДанныеСоединения из ДанныеСоединений
        если (не НеБлокирующиеПриложения().Содержит(ДанныеСоединения.Получить("application") как Строка))
             и (ДанныеСоединения.Получить("conn-id") как Число) > 0
             и ( ДанныеСоединения.Получить("session-number") как Число) == 0
            Консоль.Записать("Соединение %{ДанныеСоединения.Получить("conn-id")} (%{ДанныеСоединения.Получить("connected-at")}): %{ДанныеСоединения.Получить("host")} %{ДанныеСоединения.Получить("application")}")
            ЕстьАктивныеСоединения = Истина
        ;
    ;

    возврат ЕстьАктивныеСоединения
;

@Глобально
метод ВыполнитьМягкийПерезапускКластера(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("cluster")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("update")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--cluster", ПараметрыСоединения.ПараметрыСоединенияКластера.ИД.ВСтроку())
    если ПараметрыСоединения.ПараметрыСоединенияКластера.РасписаниеПерезапуска == Неопределено
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--lifetime-limit",   "30")
    иначе
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--restart-schedule", "*/1 * * * *")
    ;
    ДобавитьПараметрыСоединенияСАгентом(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Пауза(5м)

    Исполнитель.СброситьКлючиВыполненияПрограммы()
    
    Исполнитель.ДобавитьКлючВыполненияПрограммы("cluster")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("update")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--cluster", ПараметрыСоединения.ПараметрыСоединенияКластера.ИД.ВСтроку())
    если ПараметрыСоединения.ПараметрыСоединенияКластера.РасписаниеПерезапуска == Неопределено
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--lifetime-limit",   ПараметрыСоединения.ПараметрыСоединенияКластера.ПериодПерезапуска.ВСтроку())
    иначе
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--restart-schedule", "%{ПараметрыСоединения.ПараметрыСоединенияКластера.РасписаниеПерезапуска}")
    ;
    ДобавитьПараметрыСоединенияСАгентом(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

// СлужебныеПроцедурыИФункции

@Локально
метод ПолучитьИнформациюОбИнформационнойБазе(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("summary")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("list")
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    знч ИнформационныеБазы = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )
    для ИнформационнаяБаза из ИнформационныеБазы
        если ИнформационнаяБаза.Получить("name") == ПараметрыСоединения.ПараметрыИБ.Имя
            ПараметрыСоединения.ПараметрыИБ.ИД = новый Ууид(ИнформационнаяБаза.Получить("infobase") как Строка)
        ;
    ;
;

@Локально
метод ПолучитьИнформациюОКластере(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("cluster")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("list")
    ДобавитьСтрокуСоединенияССервером(ПараметрыСоединения, Исполнитель)

    знч ДанныеКластера = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )
    ПараметрыСоединения.ПараметрыСоединенияКластера.ИД                    = новый Ууид(ДанныеКластера[0].Получить("cluster") как Строка)
    ПараметрыСоединения.ПараметрыСоединенияКластера.ПериодПерезапуска     = ДанныеКластера[0].Получить("lifetime-limit") как Число
    ПараметрыСоединения.ПараметрыСоединенияКластера.РасписаниеПерезапуска =
        ДанныеКластера[0].СодержитКлюч("restart-schedule") ?
        ДанныеКластера[0].Получить("restart-schedule") как Строка :
        Неопределено

;

@Локально
метод ПолучитьИнформациюОбАгенте(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("agent")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("version")
    ДобавитьПараметрыСоединенияСАгентом(ПараметрыСоединения, Исполнитель)

    знч Версия = Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    ПараметрыСоединения.ПараметрыСоединенияКластера.Версия = Версия

;

@Локально
метод ПолучитьСеансыИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ) : Массив<Соответствие<Строка, Строка|Число>>

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("session")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("list")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase", ПараметрыСоединения.ПараметрыИБ.ИД.ВСтроку())
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    знч ДанныеСеансов = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )
    
    возврат ДанныеСеансов
;

@Локально
метод ЗавершитьСеансИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, ИДСеанса : Строка) : Массив<Соответствие<Строка, Строка|Число>>

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("session")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("terminate")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--session", ИДСеанса)
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    знч ДанныеСеансов = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )
    
    возврат ДанныеСеансов
;

@Локально
метод ПолучитьСоединенияИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ) : Массив<Соответствие<Строка, Строка|Число>>

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("connection")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("list")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    знч ДанныеСоединений = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )

    возврат ДанныеСоединений
;

@Локально
метод ЗавершитьСоединениеИнформационнойБазы(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, ИДСоединения : Строка, ИДПроцесса : Строка) : Массив<Соответствие<Строка, Строка|Число>>

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("connection")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("disconnect")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--process",       ИДПроцесса)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--connection",    ИДСоединения)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase-user", ПараметрыСоединения.Логин)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase-pwd",  ПараметрыСоединения.Пароль)
    ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения, Исполнитель)

    знч ДанныеСеансов = ПолучитьДанныеОтвета(
        Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()
    )
    
    возврат ДанныеСеансов
;

@Локально
метод ИнициализироватьИсполнитель(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): oc_main.Исполнитель

    знч Исполнитель = новый oc_main.Исполнитель()
    Исполнитель.ДобавитьВыполняемуюПрограмму(ПараметрыСоединения.Платформа.КлиентКластера.Путь)

    возврат Исполнитель

;

@Локально
метод ДобавитьПараметрыСоединенияСАгентом(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель)

    если не ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинСервера.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--agent-user", ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинСервера)
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--agent-pwd",  ПараметрыСоединения.ПараметрыСоединенияКластера.ПарольСервера, Истина)
    ;
    ДобавитьСтрокуСоединенияССервером(ПараметрыСоединения, Исполнитель)

;

@Локально
метод ДобавитьПараметрыСоединенияСКластером(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("--cluster", ПараметрыСоединения.ПараметрыСоединенияКластера.ИД.ВСтроку())
    если не ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинКластера.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--cluster-user", ПараметрыСоединения.ПараметрыСоединенияКластера.ЛогинКластера)
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--cluster-pwd",  ПараметрыСоединения.ПараметрыСоединенияКластера.ПарольКластера, Истина)
    ;
    ДобавитьСтрокуСоединенияССервером(ПараметрыСоединения, Исполнитель)

;

@Локально
метод ДобавитьСтрокуСоединенияССервером(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("", "%{ПараметрыСоединения.ПараметрыСоединенияКластера.Адрес}:%{ПараметрыСоединения.ПараметрыСоединенияКластера.Порт}")

;

@Локально
метод ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase",      ПараметрыСоединения.ПараметрыИБ.ИД.ВСтроку())
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase-user", ПараметрыСоединения.Логин)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--infobase-pwd",  ПараметрыСоединения.Пароль)

;

@Локально
метод НеБлокирующиеПриложения() : Множество<Строка>

    возврат{ "SrvrConsole", "JobScheduler", "RAS" }

;

@Локально
метод ПолучитьДанныеОтвета(Ответ: Строка) : Массив<Соответствие<Строка, Строка|Число>>

    знч ДанныеОтвета = новый Массив<Соответствие<Строка, Строка|Число>>()
    пер ОписаниеЭлементаДанных = новый Соответствие<Строка, Строка|Число>()
    
    для СтрокаОтвета из Ответ.ПолучитьСтроки()

        если СтрокаОтвета.Пусто()
            если ОписаниеЭлементаДанных.Размер() > 0
                ДанныеОтвета.Добавить(ОписаниеЭлементаДанных)
                ОписаниеЭлементаДанных = новый Соответствие<Строка, Строка|Число>()
            ;
            продолжить
        ;

        знч ЧастиОтвета = СтрокаОтвета.Разделить(":")
        знч Ключ = ЧастиОтвета[0].Сократить()
        знч ЗначениеСтрокой = ЧастиОтвета[1].Сократить()
        пер Значение = ЗначениеСтрокой.ТолькоЦифры() ? новый Число(ЗначениеСтрокой) : ЗначениеСтрокой
        если не (Значение это Число) и (Значение как Строка).НачинаетсяС("\"") и (Значение как Строка).ЗаканчиваетсяНа("\"")
            Значение = (Значение как Строка).Подстрока(1, (Значение как Строка).Длина() - 1)
        ;

        если ЧастиОтвета.Размер() > 0
            ОписаниеЭлементаДанных.Вставить(Ключ, Значение)
        ;
        
    ;

    если ОписаниеЭлементаДанных.Размер() > 0
        ДанныеОтвета.Добавить(ОписаниеЭлементаДанных)
    ;

    возврат ДанныеОтвета

;