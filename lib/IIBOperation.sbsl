#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl
#требуется ICluster.sbsl
#требуется IConfigurationProperties.sbsl
#требуется IConfiguration.sbsl
#требуется ILogging.sbsl
#требуется oc_main.sbsl
#требуется oc_batch_mode.sbsl
#требуется oc_ibsrv.sbsl

@Глобально
структура ИнформационнаяБаза

    обз знч Конфигурация:             IIBOperationProperties.Конфигурация
    обз знч ПараметрыСоединения:      IIBOperationProperties.ПараметрыСоединенияИБ
    обз пер Хеш:                      Строка
    знч ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища
    знч Временная:                    Булево
    пер КаталогИБ:                    Файл?
    пер ФайлВерсий:                   Файл?
    пер ФайлПоддержки:                Файл?

    // ПрограммныйИнтерфейс

    @Глобально
    статический метод ПолучитьКлючИнформационнойБазы(Конфигурация: IIBOperationProperties.Конфигурация, ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): Строка
        возврат "%{ПараметрыСоединения.Имя}_%{Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации()}"
    ;

    @Глобально
    метод АктуализироватьХеш() : Булево

        пер Результат = Ложь

        если ХешАктуальный()
            Результат = Ложь
        иначе
            Хеш = Конфигурация.Хеш
            Результат = Истина
        ;

        возврат Результат

    ;

    @Глобально
    метод ХешАктуальный() : Булево

        возврат не Хеш.Пусто() и Хеш == Конфигурация.Хеш

    ;

    @Глобально
    метод КаталогИнформационнойБазыСуществует(): Булево
        возврат не КаталогИБ == Неопределено и КаталогИБ.Существует()
    ;

    @Глобально
    метод ФайлВерсийСуществует(): Булево
        возврат ФайлВерсийОпределен() и ФайлВерсий.Существует()
    ;

    @Глобально
    метод ПолучитьАктуальностьФайлаВерсий(): Момент
        возврат ФайлВерсийСуществует() ? ФайлВерсий.Изменен : Момент{}
    ;

    @Глобально
    метод ФайлВерсийТребуетОбновления(АктуальностьФайлаВерсий: Момент): Булево
        возврат ФайлВерсий == Неопределено
                или не ФайлВерсий.Существует()
                или ФайлВерсий.Изменен.Сравнить(АктуальностьФайлаВерсий) == 0
    ;

    @Глобально
    метод УдалитьФайлВерсий()
        если ФайлВерсийСуществует()
            Файлы.Удалить(ФайлВерсий)
        ;
    ;

    @Глобально
    метод ИнициализироватьФайлПоддержки()
        если КаталогИнформационнойБазыСуществует() и ПараметрыСоединения.ВедетсяРазработка и ФайлПоддержки == Неопределено
            ФайлПоддержки = новый Файл(oc_main.ДобавитьЧастьПути(КаталогИБ.Путь, [ "ParentConfigurations.bin" ]))
        ;
    ;

    @Глобально
    метод ЗаблокироватьИнформационнуюБазу()

        если не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            возврат
        ;

        знч Кластер = ИнициализироватьКластер()
        Кластер.ЗаблокироватьИнформационнуюБазу()
    ;

    @Глобально
    метод РазблокироватьИнформационнуюБазу()

        если не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            возврат
        ;

        знч Кластер = ИнициализироватьКластер()
        Кластер.РазблокироватьИнформационнуюБазу()
    ;

    @Глобально
    метод ЗавершитьСоединенияИнформационнойБазы()

        если не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            возврат
        ;

        знч Кластер = ИнициализироватьКластер()
        Кластер.ЗавершитьСоединенияИнформационнойБазы()
    ;

    @Глобально
    метод ПроверитьАктивныеСоединенияИнформационнойБазы(): Булево

        если не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            возврат Истина
        ;

        знч Кластер = ИнициализироватьКластер()
        возврат Кластер.ПроверитьАктивныеСоединенияИнформационнойБазы()

    ;

    @Глобально
    метод ПодготовитьИнформационнуюБазуКОбновлению(): Булево

        если не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            возврат Истина
        ;

        знч Кластер = ИнициализироватьКластер()
        если не ПараметрыСоединения.КодРазрешения.Пусто()
            Кластер.ЗаблокироватьИнформационнуюБазу()
        ;
        пер БылиЗавершения = Кластер.ЗавершитьСоединенияИнформационнойБазы()
        пер ЧислоПопытокБлокировкиИБ = 0
        пока БылиЗавершения и Кластер.ПроверитьАктивныеСоединенияИнформационнойБазы()
            если ЧислоПопытокБлокировкиИБ > 3
                прервать
            ;
            Кластер.ВыполнитьМягкийПерезапускКластера()
            БылиЗавершения = Кластер.ЗавершитьСоединенияИнформационнойБазы()
            ЧислоПопытокБлокировкиИБ =+ 1
        ;

        возврат ЧислоПопытокБлокировкиИБ <= 3
    ;

    @Глобально
    метод Пустая(): Булево
        пер Результат = Ложь
        если не КаталогИБ == Неопределено
            Результат = не КаталогИБ.Существует() или КаталогИБ.Дочерние.Размер() == 0
        ;
        возврат Результат
    ;

    @Глобально
    метод СоздатьИнформационнуюБазу()

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCreateInfobase:")
        ПараметрыСоединения.Логирование.НачатьЗамер("СоздатьИнформационнуюБазу")

        знч РежимИСполнения =
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение()
            ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения
            : ПараметрыСоединения.Платформа.РежимИсполнения

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не ПараметрыСоединения.ПараметрыИБ.ЭтоСервернаяИБ
            oc_ibsrv.СоздатьИнформационнуюБазу(ПараметрыСоединения)
        иначе
            oc_batch_mode.СоздатьИнформационнуюБазу(ПараметрыСоединения)
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("ИБ успешно создана")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("СоздатьИнформационнуюБазу")
    ;

    @Глобально
    метод СоздатьРасширение(ИмяРасширения: Строка)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCreateExtension:")
        ПараметрыСоединения.Логирование.НачатьЗамер("СоздатьРасширение")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.СоздатьРасширение(
                ПараметрыСоединения,
                ИмяРасширения
            )
        иначе
            знч КаталогСкриптов = (ПараметрыСоединения.Платформа.ПутьКСкриптуИсполнения.ФайлыПроекта).Каталог
            oc_batch_mode.ЗагрузитьФайлыКонфигурации(
                ПараметрыСоединения,
                oc_main.ДобавитьЧастьПути(КаталогСкриптов.Путь, [ "lib", "EmptyTemplate" ]),
                ИмяРасширения,
                "",
                Ложь
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Расширение успешно создано")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("СоздатьРасширение")
    ;

    @Глобально
    метод УдалитьИнформационнуюБазу()
        если КаталогИнформационнойБазыСуществует()
            oc_main.УдалитьФайлСКонтролемОшибок(КаталогИБ, Логирование = ПараметрыСоединения.Логирование)
        ;
        УдалитьФайлВерсий()
    ;

    @Глобально
    метод ПроверитьНаличиеРасширения(ИмяРасширения: Строка): Булево

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCheckExtension:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ПроверитьНаличиеРасширения")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        пер СписокРасширений = ""

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            СписокРасширений = oc_ibsrv.ПолучитьСписокРасширений(ПараметрыСоединения)
        иначе
            СписокРасширений =  oc_batch_mode.ПолучитьСписокРасширений(ПараметрыСоединения)
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Список расширений успешно получен")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ПроверитьНаличиеРасширения")

        возврат СписокРасширений.Содержит(ИмяРасширения)
    ;

    @Глобально
    метод ЗагрузитьКонфигурацию(ПутьКФайлуСборки: Строка)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нLoadFromFile:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ЗагрузитьКонфигурацию")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            если ИмяРасширения.Пусто()
                // BUG 60027333. Обходим ошибку ibsrv, когда требуется снять конфигурацию с поддержки, для ее загрузки из файла
                попытка
                    oc_ibsrv.СнятьКонфигурациюСПоддержки(ПараметрыСоединения)
                    ПараметрыСоединения.Логирование.ВывестиСообщение("Конфигурация снята с поддержки")
                поймать Исключение: Исключение
                    // BUG 60027333. Ibsrv вернет ошибку, если конфигурация не находится на поддержке
                ;
            ;
            oc_ibsrv.ЗагрузитьКонфигурацию(
                ПараметрыСоединения,
                ПутьКФайлуСборки,
                ИмяРасширения
            )
        иначе
            oc_batch_mode.ЗагрузитьКонфигурацию(
                ПараметрыСоединения,
                ПутьКФайлуСборки,
                ИмяРасширения
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Файл успешно загружен: %ПутьКФайлуСборки")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ЗагрузитьКонфигурацию")
    ;

    @Глобально
    метод ЗагрузитьФайлыКонфигурации(ФайлыДляЗагрузки: Файл|Строка = "")

        пер ПутьФайлЗагрузки = ""
        если ФайлыДляЗагрузки.ПолучитьТип() == Тип<Файл>
            если (ФайлыДляЗагрузки как Файл).Существует()
                ПутьФайлЗагрузки = (ФайлыДляЗагрузки как Файл).Путь
            ;
        иначе
            знч НастройкиВыгрузки = ПолучитьНастройкиЗагрузкиВыгрузки(
                Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(),
                ФайлыДляЗагрузки как Массив<Строка>|Строка, "in"
            )
            ПутьФайлЗагрузки = НастройкиВыгрузки.Получить("ПутьФайлЗагрузкиВыгрузки") как Строка
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нLoadFromFile:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ЗагрузитьФайлыКонфигурации")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.ЗагрузитьФайлыКонфигурации(
                ПараметрыСоединения,
                Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(),
                ИмяРасширения,
                ПутьФайлЗагрузки
            )
            УдалитьФайлВерсий()
        иначе
            oc_batch_mode.ЗагрузитьФайлыКонфигурации(
                ПараметрыСоединения,
                Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(),
                ИмяРасширения,
                ПутьФайлЗагрузки
            )
            знч НовыйФайлВерсий = Конфигурация.СтруктураКонфигурации.ПолучитьФайлConfigDumpInfo()
            если не ДобавитьФайлВерсий(НовыйФайлВерсий)
                УдалитьФайлВерсий()
            ;
        ;

        знч НовыйФайлПоддержки = Конфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
        ДобавитьФайлПоддержки(НовыйФайлПоддержки)

        ПараметрыСоединения.Логирование.ВывестиСообщение("XML файлы успешно загружены в ИБ")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ЗагрузитьФайлыКонфигурации")
    ;

    @Глобально
    метод ВыгрузитьКонфигурацию(ПутьКФайлуСборки: Строка)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нDump:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыгрузитьКонфигурацию")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.ВыгрузитьКонфигурацию(
                ПараметрыСоединения,
                ПутьКФайлуСборки,
                ИмяРасширения
            )
        иначе
            oc_batch_mode.ВыгрузитьКонфигурацию(
                ПараметрыСоединения,
                ПараметрыСоединенияХранилища,
                ПутьКФайлуСборки,
                ИмяРасширения
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Файл успешно создан: %ПутьКФайлуСборки")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыгрузитьКонфигурацию")

    ;

    @Глобально
    метод ВыгрузитьФайлыКонфигурации(
            ОбъектыДляВыгрузки: Массив<Строка>|Строка|Файл = "",
            ПолнаяВыгрузка = Ложь
        )

        пер ПутьФайлВыгрузки = ""
        пер ТолькоDumpConfig = Ложь
        пер ТолькоParentConfigurations = Ложь
        если ОбъектыДляВыгрузки.ПолучитьТип() == Тип<Файл>
            если (ОбъектыДляВыгрузки как Файл).Существует()
                ПутьФайлВыгрузки = (ОбъектыДляВыгрузки как Файл).Путь
            ;
        иначе
            знч НастройкиВыгрузки = ПолучитьНастройкиЗагрузкиВыгрузки(
                Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации(),
                ОбъектыДляВыгрузки как Массив<Строка>|Строка, "out"
            )
            ПутьФайлВыгрузки = НастройкиВыгрузки.Получить("ПутьФайлЗагрузкиВыгрузки") как Строка
            ТолькоDumpConfig = НастройкиВыгрузки.Получить("ВыгружатьDumpConfig") как Булево
                и (НастройкиВыгрузки.Получить("КоличествоФайлов") как Число) == 1
            ТолькоParentConfigurations = НастройкиВыгрузки.Получить("ВыгружатьParentConfigurations") как Булево
                и (НастройкиВыгрузки.Получить("КоличествоФайлов") как Число) == 1
        ;

        если ТолькоDumpConfig
            ПараметрыСоединения.Логирование.ВывестиСообщение("\нDumpFiles(Config dump info):")
        иначе если ТолькоParentConfigurations
            ПараметрыСоединения.Логирование.ВывестиСообщение("\нDumpFiles(Parent configurations bin):")
        иначе
            ПараметрыСоединения.Логирование.ВывестиСообщение("\нDumpFiles:")
        ;
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыгрузитьФайлыКонфигурации")

        знч КаталогКонфигурации = Конфигурация.СтруктураКонфигурации.ПолучитьКаталогКонфигурации()

        если ПолнаяВыгрузка
            ПараметрыСоединения.Логирование.ВывестиСообщение("\нПолная выгрузка:")
            oc_main.УдалитьФайлСКонтролемОшибок(КаталогКонфигурации, Истина, ПараметрыСоединения.Логирование)
        ;

        если не КаталогКонфигурации.Существует()
            Файлы.СоздатьКаталог(КаталогКонфигурации)
        ;

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""
        знч ИспользоватьФайлВерсий =
            не ПолнаяВыгрузка
            и ПутьФайлВыгрузки.Пусто()
            и ФайлВерсийСуществует()

        пер ПолучитьТехническиеФайлыВыгрузки = Истина
        знч ПутьКФайламКонфигурации = Конфигурация.СтруктураКонфигурации.ПолучитьПутьКФайламКонфигурации()

        если ТолькоParentConfigurations и ФайлПоддержкиСуществует()
            // Файл поддержки выгружается с конфигурацией поставщика, поэтому кэшируем его
            знч ФайлПоддержкиПриемник= Конфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
            ПередатьФайлПоддержки(ФайлПоддержкиПриемник)
            ПолучитьТехническиеФайлыВыгрузки = Ложь
        иначе если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)

            если ТолькоDumpConfig
                oc_ibsrv.ВыгрузитьФайлыКонфигурации(
                    ПараметрыСоединения,
                    ПутьКФайламКонфигурации,
                    ИмяРасширения,
                    ТолькоDumpConfig
                )
            иначе
                oc_ibsrv.ВыгрузитьФайлыКонфигурации(
                    ПараметрыСоединения,
                    ПутьКФайламКонфигурации,
                    ИмяРасширения,
                    Ложь,
                    ПутьФайлВыгрузки,
                    ИспользоватьФайлВерсий ? ФайлВерсий.Путь : ""
                )
            ;

            ПараметрыСоединения.Логирование.ВывестиСообщение("XML файлы успешно выгружены: %ПутьКФайламКонфигурации")

        иначе

            если ТолькоDumpConfig
                oc_batch_mode.ВыгрузитьФайлыКонфигурации(
                    ПараметрыСоединения,
                    ПараметрыСоединенияХранилища,
                    ПутьКФайламКонфигурации,
                    ИмяРасширения,
                    ТолькоDumpConfig,
                    ""
                )
            иначе
                oc_batch_mode.ВыгрузитьФайлыКонфигурации(
                    ПараметрыСоединения,
                    ПараметрыСоединенияХранилища,
                    ПутьКФайламКонфигурации,
                    ИмяРасширения,
                    Ложь,
                    ПутьФайлВыгрузки,
                    ИспользоватьФайлВерсий ? ФайлВерсий.Путь : ""
                )

                ПараметрыСоединения.Логирование.ВывестиСообщение("XML файлы успешно выгружены: %ПутьКФайламКонфигурации")

            ;
        ;

        если ПолучитьТехническиеФайлыВыгрузки
            знч НовыйФайлВерсий= Конфигурация.СтруктураКонфигурации.ПолучитьФайлConfigDumpInfo()
            ДобавитьФайлВерсий(НовыйФайлВерсий)
            знч НовыйФайлПоддержки = Конфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
            ДобавитьФайлПоддержки(НовыйФайлПоддержки)
        ;

        если не ПутьФайлВыгрузки.Пусто()
            oc_main.УдалитьФайлСКонтролемОшибок(ПутьФайлВыгрузки, Логирование = ПараметрыСоединения.Логирование)
        ;

        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыгрузитьФайлыКонфигурации")
    ;

    @Глобально
    метод ВыгрузитьИнформационнуюБазу(ПутьКФайлуВыгрузки: Строка = "")

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нDumpIB:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыгрузитьИнформационнуюБазу")

        если ПараметрыСоединения.Платформа.РежимИсполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.ВыгрузитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПутьКФайлуВыгрузки
            )
        иначе
            oc_batch_mode.ВыгрузитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПутьКФайлуВыгрузки
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Информационная база успешно выгружена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ОбновитьИнформационнуюБазу")
    ;

    @Глобально
    метод ЗагрузитьИнформационнуюБазу(ПутьКФайлуВыгрузки: Строка = "")

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нRestoreIB:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ЗагрузитьИнформационнуюБазу")

        если ПараметрыСоединения.Платформа.РежимИсполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.ЗагрузитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПутьКФайлуВыгрузки
            )
        иначе
            oc_batch_mode.ЗагрузитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПутьКФайлуВыгрузки
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Информационная база успешно загружена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ОбновитьИнформационнуюБазу")

    ;

    @Глобально
    метод ОбновитьИнформационнуюБазу()

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нUpdateDBCfg:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ОбновитьИнформационнуюБазу")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""

        если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)
            oc_ibsrv.ОбновитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПараметрыСоединения.Платформа.ПараметрыОбновления,
                ИмяРасширения
            )
        иначе
            oc_batch_mode.ОбновитьИнформационнуюБазу(
                ПараметрыСоединения,
                ПараметрыСоединения.Платформа.ПараметрыОбновления,
                ИмяРасширения
            )
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Информационная база успешно обновлена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ОбновитьИнформационнуюБазу")

    ;

    @Глобально
    метод ПолучитьСтатусКонфигурации(ПутьКФайлуСтатуса: Строка) : Число

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нDumpFiles(Status):")
        ПараметрыСоединения.Логирование.НачатьЗамер("ПолучитьСтатусКонфигурации")

        знч РежимИСполнения = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? ПараметрыСоединения.Платформа.РежимИСполненияРасширения : ПараметрыСоединения.Платформа.РежимИсполнения
        знч ИмяРасширения   = Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""
        пер СтатусКонфигурации = 0
        пер ТекстСтатуса       = ""

        если не ФайлВерсийСуществует()
            ТекстСтатуса = "Файл версии не определен"
            СтатусКонфигурации = 2
        иначе если РежимИСполнения == IIBOperationProperties.РежимыИсполнения.АвтономныйСервер и не oc_main.ЭтоСервернаяИБ(ПараметрыСоединения.СтрокаСоединения)

            oc_ibsrv.ПолучитьСтатусКонфигурации(
                ПараметрыСоединения,
                ПутьКФайлуСтатуса,
                ИмяРасширения,
                ФайлВерсий.Путь
            )

            ТекстСтатуса = (новый Файл(ПутьКФайлуСтатуса)).ОткрытьПотокЧтения().ПрочитатьКакСтроку()

            если ТекстСтатуса.Найти("modified: all") >= 0
                СтатусКонфигурации = 2
            иначе если не ТекстСтатуса.Пусто()
                СтатусКонфигурации = 1
            ;

        иначе

            oc_batch_mode.ПолучитьСтатусКонфигурации(
                ПараметрыСоединения,
                ПараметрыСоединенияХранилища,
                ПутьКФайлуСтатуса,
                ИмяРасширения,
                ФайлВерсий.Путь
            )

            ТекстСтатуса = (новый Файл(ПутьКФайлуСтатуса)).ОткрытьПотокЧтения().ПрочитатьКакСтроку()
            если ТекстСтатуса.Найти("FullDump") >= 0
                СтатусКонфигурации = 2
            иначе если не ТекстСтатуса.Пусто()
                СтатусКонфигурации = 1
            ;
        ;

        ПараметрыСоединения.Логирование.ВывестиСообщение("Статус конфигурации успешно получен: %ПутьКФайлуСтатуса")
        ПараметрыСоединения.Логирование.ВывестиСообщение("\н")
        ПараметрыСоединения.Логирование.ВывестиСообщение(ТекстСтатуса)

        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ПолучитьСтатусКонфигурации")

        возврат СтатусКонфигурации
    ;

    @Глобально
    метод ПодключитьсяКХранилищуКонфигурации()

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нConfigurationRepositoryBindCfg:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыгрузитьКонфигурациюХранилищаКонфигурации")

        oc_batch_mode.ПодключитьсяКХранилищуКонфигурации(
            ПараметрыСоединения,
            ПараметрыСоединенияХранилища,
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Подключение к хранилищу выполнено")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыгрузитьКонфигурациюХранилищаКонфигурации")

    ;

    @Глобально
    метод ПолучитьДанныеХранилищаКонфигурации(ПутьКФайлуОтчета: Строка) : Соответствие<Строка, Объект?>

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нConfigurationRepositoryReport:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ПолучитьДанныеХранилищаКонфигурации")

        oc_batch_mode.ПолучитьОтчетПоХранилищуКонфигурации(
            ПараметрыСоединения,
            ПараметрыСоединенияХранилища,
            ПутьКФайлуОтчета,
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""
        )

        знч СимволПереноса = "###"
        пер ТекстОтчета = (новый Файл(ПутьКФайлуОтчета)).ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        ПараметрыСоединения.Логирование.ВывестиСообщение("\н")
        ПараметрыСоединения.Логирование.ВывестиСообщение(ТекстОтчета)
        ТекстОтчета = ТекстОтчета.Заменить("\r\n", СимволПереноса)

        пер ТекущийНомерВерсии = "0"
        пер ТекущийАвтор = ""
        пер ТекущийКомментарий = ""

        знч ОбразецПоискаВерсии = новый Образец("Версия:.(?<Версия>\\ц+?)%{СимволПереноса}")
        знч РезультатПоискаВерсии = ОбразецПоискаВерсии.НайтиСовпадения(ТекстОтчета)
        для ОчереднойРезультат из РезультатПоискаВерсии
            ТекущийНомерВерсии = ОчереднойРезультат.Группа("Версия")
        ;

        знч ОбразецПоискаАвтора = новый Образец("Пользователь:.(?<Пользователь>.+?)%{СимволПереноса}")
        знч РезультатПоискаАвтора = ОбразецПоискаАвтора.НайтиСовпадения(ТекстОтчета)
        для ОчереднойРезультат из РезультатПоискаАвтора
            ТекущийАвтор = ОчереднойРезультат.Группа("Пользователь")
        ;

        знч ОбразецПоискаКомментарий = новый Образец("Комментарий:%{СимволПереноса}(?<Комментарий>[^\t]+)%{СимволПереноса}%{СимволПереноса}\t")
        знч РезультатПоискаКомментарий = ОбразецПоискаКомментарий.НайтиСовпадения(ТекстОтчета)
        для ОчереднойРезультат из РезультатПоискаКомментарий
            ТекущийКомментарий = ОчереднойРезультат.Группа("Комментарий")
        ;
        ТекущийКомментарий = ТекущийКомментарий.Заменить(СимволПереноса, "\r\n")

        знч Результат = новый Соответствие<Строка, Объект?>()
        Результат.Вставить("НомерВерсии", ТекущийНомерВерсии)
        Результат.Вставить("Автор",       ТекущийАвтор)
        Результат.Вставить("Комментарий", ТекущийКомментарий)

        ПараметрыСоединения.Логирование.ВывестиСообщение("Отчет хранилища конфигурации получен")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ПолучитьДанныеХранилищаКонфигурации")

        возврат Результат
    ;

    @Глобально
    метод ВыгрузитьКонфигурациюХранилищаКонфигурации(ПутьКФайлуКонфигурации: Строка, Версия: Строка)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нConfigurationRepositoryDumpCfg:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыгрузитьКонфигурациюХранилищаКонфигурации")

        oc_batch_mode.ВыгрузитьКонфигурациюХранилищаКонфигурации(
            ПараметрыСоединения,
            ПараметрыСоединенияХранилища,
            ПутьКФайлуКонфигурации,
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : "",
            Версия
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Конфигурация из хранилища выгружена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыгрузитьКонфигурациюХранилищаКонфигурации")

    ;

    @Глобально
    метод ПолучитьИзмененияИзХранилищаКонфигурации(Версия: Строка)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нConfigurationRepositoryUpdateCfg:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ПолучитьИзмененияИзХранилищаКонфигурации")

        oc_batch_mode.ПолучитьИзмененияИзХранилищаКонфигурации(
            ПараметрыСоединения,
            ПараметрыСоединенияХранилища,
            Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : "",
            Версия
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("ИЗменения из хранилища конфигурации получены")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ПолучитьИзмененияИзХранилищаКонфигурации")

    ;

    @Глобально
    метод ВыполнитьПроверкуКонфигурации(ПроверитьВсеРасширения = Ложь)


        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCheck:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыполнитьПроверкуКонфигурации")

        oc_batch_mode.ВыполнитьПроверкуКонфигурации(
            ПараметрыСоединения,
            ПроверитьВсеРасширения ? "AllExtensions" : (Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : ""),
            ПараметрыСоединения.Платформа.Проверки.ВоМножество()
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Проверка конфигурации завершена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыполнитьПроверкуКонфигурации")
    ;

    @Глобально
    метод ВыполнитьПроверкуПримененияРасширений(ПроверитьВсеРасширения = Ложь)

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCheckCanApplyConfigurationExtensions:")
        ПараметрыСоединения.Логирование.НачатьЗамер("ВыполнитьПроверкуПримененияРасширений")

        oc_batch_mode.ВыполнитьПроверкуПримененияРасширений(
            ПараметрыСоединения,
            ПроверитьВсеРасширения ? "AllExtensions" : (Конфигурация.СтруктураКонфигурации.ЭтоРасширение() ? Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации() : "")
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Проверка применения расширений завершена")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыполнитьПроверкуКонфигурации")
    ;

    @Глобально
    метод ВыполнитьТестированиеИсправление()

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCheckAndRep:")

        ПараметрыСоединения.Логирование.НачатьЗамер("ВыполнитьТестированиеИсправление")

        oc_batch_mode.ВыполнитьТестированиеИсправление(
            ПараметрыСоединения,
            ПараметрыСоединения.Платформа.ПроверкиТИС
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Тестирование и исправление завершено")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("ВыполнитьТестированиеИсправление")

    ;

    @Глобально
    метод СравнитьКонфигурации(
            ПутьКФайлуОтчета: Строка,
            РежимСравнения: oc_main.РежимыСравнения,
            ИмяКонфигурацииПоставщика = ""
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("\нCompareCfg:")
        ПараметрыСоединения.Логирование.НачатьЗамер("СравнитьКонфигурации")

        знч ПерваяКонфигурация = "MainConfiguration"
        знч ВтораяКонфигурация = (РежимСравнения == oc_main.РежимыСравнения.СравнитьСКонфигурациейИБ)
            ? "DBConfiguration"
            : "VendorConfiguration"

        oc_batch_mode.СравнитьКонфигурации(
            ПараметрыСоединения,
            ПутьКФайлуОтчета,
            ПерваяКонфигурация,
            ВтораяКонфигурация,
            ИмяКонфигурацииПоставщика
        )

        ПараметрыСоединения.Логирование.ВывестиСообщение("Файл сравнение основной конфигурации и конфигурации БД успешно получен")
        ПараметрыСоединения.Логирование.ЗавершитьЗамер("СравнитьКонфигурации")

    ;

    @Глобально
    статический метод ПолучитьИнформационнуюБазуКонфигурации(
            Конфигурация: IIBOperationProperties.Конфигурация,
            ПараметрыСоединенияИБ: IIBOperationProperties.ПараметрыСоединенияИБ,
            Хеш: Строка,
            Временная = Ложь
        ): ИнформационнаяБаза

        знч ПараметрыСоединенияХранилищаИБ = ПараметрыСоединенияИБ.ПараметрыСоединенийХранилищ.ПолучитьИлиУмолчание(
            Конфигурация.СтруктураКонфигурации.ПолучитьИмяКонфигурации(),
            новый IIBOperationProperties.ПараметрыСоединенияХранилища()
        )
        знч ПараметрыСоединенияХранилища = новый IIBOperationProperties.ПараметрыСоединенияХранилища(
            не ПараметрыСоединенияХранилищаИБ.Путь.Пусто() ? ПараметрыСоединенияХранилищаИБ.Путь : Конфигурация.ПараметрыХранилища.ПараметрыСоединения.Путь,
            ПараметрыСоединенияХранилищаИБ.Логин,
            ПараметрыСоединенияХранилищаИБ.Пароль
        )

        пер КаталогИБ: Файл? = Неопределено
        если oc_main.ЭтоФайловаяИБ(ПараметрыСоединенияИБ.СтрокаСоединения)
            КаталогИБ = новый Файл(oc_main.ПреобразоватьВПутьКИнформационнойБазе(ПараметрыСоединенияИБ.СтрокаСоединения))
        ;

        знч ИнформационнаяБаза = новый ИнформационнаяБаза(
            Конфигурация,
            ПараметрыСоединенияИБ,
            Хеш,
            ПараметрыСоединенияХранилища,
            Временная,
            КаталогИБ
        )

        ИнформационнаяБаза.ИнициализироватьФайлПоддержки()

        возврат ИнформационнаяБаза

    ;

    // СлужебныеПроцедурыИФункции

    @Локально
    метод ИнициализироватьКластер(): ICluster.Кластер
        знч Кластер = новый ICluster.Кластер(ПараметрыСоединения)
        Кластер.Инициализировать()
        возврат Кластер
    ;

    @Локально
    метод ФайлВерсийОпределен(): Булево
        возврат не ФайлВерсий == Неопределено
    ;

    @Локально
    метод ДобавитьФайлВерсий(НовыйФайлВерсий: Файл): Булево
        пер Результат = Ложь
        если ФайлВерсийОпределен()
            и не ФайлВерсий.Путь == НовыйФайлВерсий.Путь
            и НовыйФайлВерсий.Существует()
            Файлы.Скопировать(НовыйФайлВерсий, ФайлВерсий)
            Результат = Истина
        ;
        возврат Результат
    ;

    @Локально
    метод ФайлПоддержкиОпределен(): Булево
        возврат не ФайлПоддержки == Неопределено
    ;

    @Локально
    метод ФайлПоддержкиСуществует(): Булево
        возврат ФайлПоддержкиОпределен() и ФайлПоддержки.Существует()
    ;

    @Локально
    метод ДобавитьФайлПоддержки(НовыйФайлПоддержки: Файл): Булево
        ИнициализироватьФайлПоддержки()
        если ФайлПоддержкиОпределен()
            и НовыйФайлПоддержки.Существует()
            Файлы.Скопировать(НовыйФайлПоддержки, ФайлПоддержки)
        ;
        возврат Ложь
    ;

    @Локально
    метод ПередатьФайлПоддержки(ФайлПоддержкиПриемник: Файл)
        если ФайлПоддержкиСуществует()
            Файлы.Скопировать(ФайлПоддержки, ФайлПоддержкиПриемник)
        ;
    ;

    @Локально
    метод ПолучитьНастройкиЗагрузкиВыгрузки(ПутьКФайлуСборки: Строка, ФайлыКонфигурации: Массив<Строка>|Строка, ТипЗагрузкиВыгрузки: Строка) : Соответствие<Строка, Строка|Булево|Число>

        пер ФайлыЗагрузкиВыгрузки = новый Массив<Строка>()

        если ФайлыКонфигурации.ПолучитьТип() == Тип<Строка>
            ФайлыЗагрузкиВыгрузки = (ФайлыКонфигурации как Строка).Разделить(",", Ложь)
        иначе если ФайлыЗагрузкиВыгрузки.ПолучитьТип() == Тип<Массив<Строка>>
            ФайлыЗагрузкиВыгрузки = ФайлыКонфигурации как Массив<Строка>
        ;

        пер ТекстФайлаЗагрузкиВыгрузки = ""
        пер ВыгружатьDumpConfig = Ложь
        пер ВыгружатьParentConfigurations = Ложь
        пер КоличествоФайлов = 0

        для ПутьКФайлу из ФайлыЗагрузкиВыгрузки
            КоличествоФайлов =+ 1
            если ПутьКФайлу.ЗаканчиваетсяНа("ConfigDumpInfo.xml")
                ВыгружатьDumpConfig = Истина
                продолжить
            иначе если ПутьКФайлу.ЗаканчиваетсяНа("ParentConfigurations")
                ВыгружатьParentConfigurations = Истина
            ;
            ТекстФайлаЗагрузкиВыгрузки = ТекстФайлаЗагрузкиВыгрузки + ПутьКФайлу + Символы.НОВАЯ_СТРОКА
        ;

        знч Результат = новый Соответствие<Строка, Строка|Булево|Число>()
        
        пер ПутьФайлЗагрузкиВыгрузки = ""
        если не ТекстФайлаЗагрузкиВыгрузки.Пусто()
            ПутьФайлЗагрузкиВыгрузки = ПутьКФайлуСборки + "_" + ТипЗагрузкиВыгрузки
            пер ФайлЗагрузкиВыгрузки = новый Файл(ПутьФайлЗагрузкиВыгрузки)
            если ФайлЗагрузкиВыгрузки.Существует()
                Файлы.Удалить(ФайлЗагрузкиВыгрузки)
            ;
            ФайлЗагрузкиВыгрузки = Файлы.Создать(ПутьФайлЗагрузкиВыгрузки)
            ФайлЗагрузкиВыгрузки.ОткрытьПотокЗаписи().Записать(ТекстФайлаЗагрузкиВыгрузки).Закрыть()
        ;

        Результат.Вставить("ПутьФайлЗагрузкиВыгрузки",      ПутьФайлЗагрузкиВыгрузки)
        Результат.Вставить("ВыгружатьDumpConfig",           ВыгружатьDumpConfig)
        Результат.Вставить("ВыгружатьParentConfigurations", ВыгружатьParentConfigurations)
        Результат.Вставить("КоличествоФайлов",              КоличествоФайлов)

        возврат Результат
    ;

;