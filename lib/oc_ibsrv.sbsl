#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl

@Локально
структура ПараметрыОбновленияКонфигурации

    знч Параметры: Множество<Строка> = {
        "dynamic", // force, disable
        "force",
        "session-terminate", // force, disable
        "session-terminate-message" // любой текст
    }

;

// ПрограммныйИнтерфейс

@Глобально
метод СоздатьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("create")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--force")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель, Ложь)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод СоздатьРасширение(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ИмяРасширения: Строка, ПрефиксРасширения = "Ext_", НазначениеРасширения = "customization"
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("extension")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("create")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--name",        ИмяРасширения)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--name-prefix", ПрефиксРасширения)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--purpose",     НазначениеРасширения)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ПолучитьСписокРасширений(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ
    ): Строка

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("extension")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("list")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    знч Результат = Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    возврат Результат
;

@Глобально
метод ЗагрузитьКонфигурацию(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуСборки: Строка, ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("load")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПутьКФайлуСборки)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ЗагрузитьФайлыКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайламПроекта:  Строка, ИмяРасширения = "", ПутьКФайлуЗагрузки = ""
    )

//    область
//
//        если не ПутьКФайлуЗагрузки.Пусто()
//            знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)
//            Исполнитель.ДобавитьКлючВыполненияПрограммы("/c")
//            Исполнитель.ДобавитьКлючВыполненияПрограммы("type \"%{ПутьКФайлуЗагрузки}\"")
//        ;
//
//    ;

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("import")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    если не ПутьКФайлуЗагрузки.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("files")
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--no-check")
        если ПутьКФайламПроекта.ЗаканчиваетсяНа(".zip")
            Исполнитель.ДобавитьКлючВыполненияПрограммы("--archive",  ПутьКФайламПроекта)
        иначе
            Исполнитель.ДобавитьКлючВыполненияПрограммы("--base-dir", ПутьКФайламПроекта)
        ;
        знч ФайлыЗагрузки = новый Файл(ПутьКФайлуЗагрузки).ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        для ПутьКФайлу из ФайлыЗагрузки.Разделить(Символы.НОВАЯ_СТРОКА)
            Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПутьКФайлу)
        ;
    иначе
        Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПутьКФайламПроекта)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ВыгрузитьКонфигурацию(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуСборки:    Строка, ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("save")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПутьКФайлуСборки)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ВыгрузитьФайлыКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайламПроекта:  Строка, ИмяРасширения = "", ТолькоDumpConfig = Ложь, ПутьКФайлуВыгрузки = "", ПутьКФайлуВерсии = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("export")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    пер ОсновнаяВыгрузка = Ложь
    если ТолькоDumpConfig
        Исполнитель.ДобавитьКлючВыполненияПрограммы("info")
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--out", ПутьКФайламПроекта) // ошибка платформы, пока указывается каталог, а не файл ConfigDumpInfo.xml
    иначе если не ПутьКФайлуВыгрузки.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("objects")
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--out", ПутьКФайламПроекта)
        // Исполнитель.ДобавитьКлючВыполненияПрограммы("--recursive")
        знч ОбъектыВыгрузки = новый Файл(ПутьКФайлуВыгрузки).ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        для Объект из ОбъектыВыгрузки.Разделить(Символы.НОВАЯ_СТРОКА)
            Исполнитель.ДобавитьКлючВыполненияПрограммы("", Объект)
        ;
    иначе
        ОсновнаяВыгрузка = Истина
    ;
    если не ПутьКФайлуВерсии.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--base", ПутьКФайлуВерсии)
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--threads", "4")
    если ОсновнаяВыгрузка
        Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПутьКФайламПроекта)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ОбновитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыОбновления: Массив<Строка>, ИмяРасширения = ""
    )

    знч ПараметрыОбновленияКонфигурации = новый ПараметрыОбновленияКонфигурации()

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("apply")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--force")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;

    для ПараметрОбновления из ПараметрыОбновления
        знч ИмяПараметра = ПараметрОбновления.Разделить("=")[0]
        если не ПараметрыОбновленияКонфигурации.Параметры.Содержит(ИмяПараметра)
            продолжить
        ;
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--%{ПараметрОбновления}")
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ВыгрузитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуВыгрузки = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("dump")
    Исполнитель.ДобавитьКлючВыполненияПрограммы(ПутьКФайлуВыгрузки.Пусто() ? ПараметрыСоединения.ПолучитьПутьКФайлуВыгрузки() : ПутьКФайлуВыгрузки)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ЗагрузитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуВыгрузки = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("restore")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--force")
    Исполнитель.ДобавитьКлючВыполненияПрограммы(ПутьКФайлуВыгрузки.Пусто() ? ПараметрыСоединения.ПолучитьПутьКФайлуВыгрузки() : ПутьКФайлуВыгрузки)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ПолучитьСтатусКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуСтатуса: Строка, ИмяРасширения = "", ПутьКФайлуВерсии = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("export")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("status")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--out", ПутьКФайлуСтатуса) // ошибка платформы, пока указывается каталог, а не файл ConfigDumpInfo.xml
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--base", ПутьКФайлуВерсии)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод СнятьКонфигурациюСПоддержки(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("support")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("disable")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("--force")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

@Глобально
метод ВыполнитьПроверкуКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ИмяРасширения =      ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("infobase")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("config")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("check")
    если не ИмяРасширения.Пусто() и не ИмяРасширения == "AllExtensions"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

;

// СлужебныеПроцедурыИФункции

@Локально
метод ИнициализироватьИсполнитель(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): oc_main.Исполнитель

    знч Исполнитель = новый oc_main.Исполнитель(Логирование = ПараметрыСоединения.Логирование)
    Исполнитель.ДобавитьВыполняемуюПрограмму(ПараметрыСоединения.Платформа.АвтономныйСервер.Путь)

    возврат Исполнитель

;

@Локально
метод ДобавитьПараметрыСоединенияИБ(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель,
        ДобавитьПараметрыАвторизации = Истина
    )

    Исполнитель.ДобавитьКлючВыполненияПрограммы("--db-path",  ПараметрыСоединения.ПараметрыИБ.ПутьКФайловойИБ)
    если ДобавитьПараметрыАвторизации
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--user",     ПараметрыСоединения.Логин)
        Исполнитель.ДобавитьКлючВыполненияПрограммы("--password", ПараметрыСоединения.Пароль, Истина)
    ;

;