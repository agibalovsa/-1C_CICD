#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl
#требуется oc_cluster_element.sbsl
#требуется oc_cluster_rac.sbsl
#требуется oc_main.sbsl

@Глобально
структура Кластер

    обз знч ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ

    @Глобально
    метод Инициализировать()
        если ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            oc_cluster_rac.Инициализировать(ПараметрыСоединения)
        иначе
            oc_cluster_element.Инициализировать(ПараметрыСоединения)
        ;
    ;

    @Глобально
    метод ЗаблокироватьИнформационнуюБазу()
        если ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            oc_cluster_rac.ЗаблокироватьИнформационнуюБазу(ПараметрыСоединения)
        иначе
            oc_cluster_element.ЗаблокироватьИнформационнуюБазу(ПараметрыСоединения)
        ;
    ;

    @Глобально
    метод РазблокироватьИнформационнуюБазу()
        если ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            oc_cluster_rac.РазблокироватьИнформационнуюБазу(ПараметрыСоединения)
        иначе
            oc_cluster_element.РазблокироватьИнформационнуюБазу(ПараметрыСоединения)
        ;
    ;

    @Глобально
    метод ЗавершитьСоединенияИнформационнойБазы(): Булево
        пер БылиЗавершения = Ложь
        если ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            БылиЗавершения = oc_cluster_rac.ЗавершитьСоединенияИнформационнойБазы(ПараметрыСоединения)
        иначе
            БылиЗавершения = oc_cluster_element.ЗавершитьСоединенияИнформационнойБазы(ПараметрыСоединения)
        ;
        возврат БылиЗавершения
    ;

    @Глобально
    метод ПроверитьАктивныеСоединенияИнформационнойБазы(): Булево
        знч АктивныеСоединения =
            ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            ? oc_cluster_rac.ПроверитьАктивныеСоединенияИнформационнойБазы(ПараметрыСоединения)
            : oc_cluster_element.ПроверитьАктивныеСоединенияИнформационнойБазы(ПараметрыСоединения)
        
        для Соединение из АктивныеСоединения
            ПараметрыСоединения.Логирование.ВывестиСообщение(Соединение)
        ;
        возврат АктивныеСоединения.Размер() > 0
    ;

    @Глобально
    метод ВыполнитьМягкийПерезапускКластера()
        если ПараметрыСоединения.ПараметрыСоединенияКластера.РежимРаботыСКластером == IIBOperationProperties.РежимыРаботыСКластером.Агент
            oc_cluster_rac.ВыполнитьМягкийПерезапускКластера(ПараметрыСоединения)
        иначе
            oc_cluster_element.ВыполнитьМягкийПерезапускКластера(ПараметрыСоединения)
        ;
    ;

;