#!/usr/bin/executor

#требуется ILogging.sbsl

@Глобально
структура ПараметрыGit

    знч Используется: Булево
    пер Путь: Строка
    пер ОсновнаяВетка: Строка
    пер ЛокальныйПуть: Строка
    пер Логин: Строка
    пер Пароль: Строка
    пер Ключ: Строка

// ПрограммныйИнтерфейс

// ВнешнееХранилище

    @Глобально
    метод ПолучитьВнешнееХранилище(Логирование: ILogging.Логирование)

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ПараметрыПроцесса.Добавить("clone")
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить(ЛокальныйПуть)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Файлы.Удалить(ВременныйФайл, Истина)

        Логирование.ВывестиСообщение("Хранилище Git получено")

    ;

    @Глобально
    метод ПолучитьИзмененияИзВнешнегоХранилища(ИмяВетки = "", Логирование: ILogging.Логирование): Булево

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        если не ТекущаяВеткаХранилищаСопоставленаСВнешней(ИмяВетки, Логирование)
            возврат Ложь
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("pull")
        ПараметрыПроцесса.Добавить("origin")
        ПараметрыПроцесса.Добавить(ИмяВетки)
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Файлы.Удалить(ВременныйФайл, Истина)

        Логирование.ВывестиСообщение("Получены изменения из хранилище Git")

        возврат Истина

    ;

    @Глобально
    метод ОтправитьИзмененияВоВнешнееХранилище(ИмяВетки = "", Логирование: ILogging.Логирование)

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("push")
        ПараметрыПроцесса.Добавить("--set-upstream")
        ПараметрыПроцесса.Добавить("origin")
        ПараметрыПроцесса.Добавить("%{ИмяВетки}:%{ИмяВетки}")
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Файлы.Удалить(ВременныйФайл, Истина)

        Логирование.ВывестиСообщение("Отправлены изменения в хранилище Git")

    ;

    @Глобально
    метод ПроверитьСуществованиеВеткиВнешнегоХранилища(ИмяВетки = "", Логирование: ILogging.Логирование): Число

        пер Результат = 0

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("branch")
        ПараметрыПроцесса.Добавить("-r")
        ПараметрыПроцесса.Добавить("--list")
        ПараметрыПроцесса.Добавить("origin/%{ИмяВетки}")
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        знч РезультатКоманды = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        если РезультатКоманды.Содержит("*")
            Результат = 2 // Искомая ветка - текущая
        иначе если РезультатКоманды.Сократить() == "origin/%{ИмяВетки}"
            Результат = 1 // Искомая ветка существует
        ;

        Файлы.Удалить(ВременныйФайл, Истина)

        возврат Результат

    ;

    @Глобально
    метод ПерейтиНаВеткуВнешнегоХранилища(ИмяВетки = "", Логирование: ILogging.Логирование) : Булево

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        пер СтатусВетки = ПроверитьСуществованиеВеткиВнешнегоХранилища(ИмяВетки, Логирование)

        если СтатусВетки == 0
            возврат Ложь
        иначе если СтатусВетки == 2
            возврат Истина
        ;

        если ПерейтиНаВеткуХранилища(ИмяВетки, Логирование)
            возврат ПолучитьИзмененияИзВнешнегоХранилища(ИмяВетки, Логирование)
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("checkout")
        ПараметрыПроцесса.Добавить("-b")
        ПараметрыПроцесса.Добавить(ИмяВетки)
        ПараметрыПроцесса.Добавить("origin/%{ИмяВетки}")
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Файлы.Удалить(ВременныйФайл, Истина)

        возврат Истина

    ;

    @Глобально
    метод ПолучитьДанныеФайлаВнешнегоХранилища(ПутьКФайлу: Строка, ИмяВетки = "", Логирование: ILogging.Логирование) : Строка

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("show")
        ПараметрыПроцесса.Добавить("origin/%{ИмяВетки}:%{ПутьКФайлу}")
        ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса)
        знч ВременныйФайл = ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса)

        знч ДанныеФайла = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Файлы.Удалить(ВременныйФайл, Истина)

        возврат ДанныеФайла
    ;

    // ЛокальноеХранилище

    @Глобально
    метод СоздатьВеткуХранилища(ИмяВетки = "", ВеткаРодитель = "", Логирование: ILogging.Логирование)

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        если ВеткаРодитель.Пусто()
            ВеткаРодитель = ОсновнаяВетка
        ;

        если ИмяВетки == ВеткаРодитель
            возврат
        ;

        если ПерейтиНаВеткуХранилища(ИмяВетки, Логирование)
            возврат
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("checkout")
        ПараметрыПроцесса.Добавить("-b")
        ПараметрыПроцесса.Добавить("%{ИмяВетки}")
        если не ВеткаРодитель.Пусто()
            ПараметрыПроцесса.Добавить("%{ВеткаРодитель}")
        ;

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        Логирование.ВывестиСообщение("Создана ветка %{ИмяВетки}")

    ;

    @Глобально
    метод ПолучитьИмяТекущейВеткиХранилища(Логирование: ILogging.Логирование): Строка

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("branch")
        ПараметрыПроцесса.Добавить("--list")
    
        знч Ветки = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        знч ОбразецПоискаВерсии = '\*.(?<ИмяВетки>.*)'
        знч РезультатПоискаВерсии = ОбразецПоискаВерсии.НайтиСовпадения(Ветки)
        пер ИмяВетки = ""
        для ОчереднойРезультат из РезультатПоискаВерсии
            ИмяВетки = ОчереднойРезультат.Группа("ИмяВетки")
        ;

        возврат ИмяВетки

    ;

    @Глобально
    метод ПолучитьИмяВнешнейВеткиХранилища(ИмяВетки = "", Логирование: ILogging.Логирование): Строка

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("branch")
        ПараметрыПроцесса.Добавить("--list")
        ПараметрыПроцесса.Добавить("-vv")
        ПараметрыПроцесса.Добавить(ИмяВетки)
    
        знч Ветки = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        знч ОбразецПоиска = '.*\[(?<ИмяВнешнейВетки>.*)\].*'
        знч РезультатПоиска = ОбразецПоиска.НайтиСовпадения(Ветки)
        пер ИмяВнешнейВетки = ""
        для ОчереднойРезультат из РезультатПоиска
            ИмяВнешнейВетки = ОчереднойРезультат.Группа("ИмяВнешнейВетки")
        ;

        возврат ИмяВнешнейВетки

    ;

    @Глобально
    метод ТекущаяВеткаХранилищаОсновная(Логирование: ILogging.Логирование): Булево

        знч ИмяВетки = ПолучитьИмяТекущейВеткиХранилища(Логирование)

        возврат ИмяВетки == ОсновнаяВетка

    ;

    @Глобально
    метод ТекущаяВеткаХранилищаСопоставленаСВнешней(ИмяВетки = "", Логирование: ILogging.Логирование): Булево

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ИмяВнешнейВетки = ПолучитьИмяВнешнейВеткиХранилища(ИмяВетки, Логирование)

        возврат не ИмяВнешнейВетки.Пусто()

    ;

    @Глобально
    метод ПерейтиНаВеткуХранилища(ИмяВетки = "", Логирование: ILogging.Логирование): Булево

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        пер СтатусВетки = ПроверитьСуществованиеВеткиХранилища(ИмяВетки, Логирование)

        если СтатусВетки == 0
            возврат Ложь
        иначе если СтатусВетки == 2
            возврат Истина
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("checkout")
        ПараметрыПроцесса.Добавить(ИмяВетки)
    
        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        возврат Истина

    ;

    @Глобально
    метод ПроверитьСуществованиеВеткиХранилища(ИмяВетки = "", Логирование: ILogging.Логирование): Число

        пер Результат = 0

        если ИмяВетки.Пусто()
            ИмяВетки = ОсновнаяВетка
        ;

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("branch")
        ПараметрыПроцесса.Добавить("--list")
        ПараметрыПроцесса.Добавить("%{ИмяВетки}")

        знч РезультатКоманды = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)
        если РезультатКоманды.Содержит("*")
            Результат = 2 // Искомая ветка - текущая
        иначе если РезультатКоманды.Сократить() == ИмяВетки
            Результат = 1 // Искомая ветка существует
        ;

        возврат Результат

    ;

    @Глобально
    метод ИмеютсяИзмененияВХранилище(Логирование:  ILogging.Логирование): Булево

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("status")
        ПараметрыПроцесса.Добавить("--short")

        знч ИзмененияВКонфигурации = ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

        возврат не ИзмененияВКонфигурации.Пусто()

    ;

    @Глобально
    метод ПроиндексироватьИзмененияВХранилище(Файлы = ".", Логирование: ILogging.Логирование)

        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("add")
        ПараметрыПроцесса.Добавить(Файлы)

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)

    ;

    @Глобально
    метод ЗафиксироватьИзмененияВХранилище(КомментарийХранилища: Строка, АвторФиксации = "", Логирование: ILogging.Логирование)

        ПроиндексироватьИзмененияВХранилище(Логирование = Логирование)

        если не АвторФиксации.Пусто() и не АвторФиксации.ПолноеСовпадение('.+<.+>')
            АвторФиксации = АвторФиксации.Сократить() + "<empty>"
        ;
        знч ПараметрыПроцесса = новый Массив<Строка>()
        ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса)
        ПараметрыПроцесса.Добавить("commit")
        если не АвторФиксации.Пусто()
            ПараметрыПроцесса.Добавить("--author=\"%{АвторФиксации}\"")
        ;
        ПараметрыПроцесса.Добавить("-m")
        ПараметрыПроцесса.Добавить("\"%{КомментарийХранилища}\"")

        ВыполнитьКомандуСОжиданием("git", ПараметрыПроцесса, Логирование = Логирование)
    ;

    // СлужебныеПроцедурыИФункции

    @Локально
    метод ДополнитьПараметрыПроцессаПутьКХранилищу(ПараметрыПроцесса: Массив<Строка>)

        пер ПутьКХранилищуЛогинПароль = Путь

        если не Логин.Пусто() и не Пароль.Пусто()
            если ПутьКХранилищуЛогинПароль.НачинаетсяС("http://")
                ПутьКХранилищуЛогинПароль = "http://%{Логин}:%{Пароль}@%{Путь.Подстрока(8)}"
            иначе если ПутьКХранилищуЛогинПароль.НачинаетсяС("https://")
                ПутьКХранилищуЛогинПароль = "https://%{Логин}:%{Пароль}@%{Путь.Подстрока(9)}"
            ;
        ;

        если не ПутьКХранилищуЛогинПароль.Пусто()
            ПараметрыПроцесса.Добавить(ПутьКХранилищуЛогинПароль)
        ;

    ;

    @Локально
    метод ДополнитьПараметрыПроцессаПутьКЛокальномуХранилищу(ПараметрыПроцесса: Массив<Строка>)

        если не ЛокальныйПуть.Пусто()
            ПараметрыПроцесса.Добавить("-C")
            ПараметрыПроцесса.Добавить(ЛокальныйПуть)
        ;

    ;

    @Локально
    метод ДополнитьПараметрыПроцессаКлючом(ПараметрыПроцесса: Массив<Строка>): Файл

        знч ВременныйФайл = Файлы.СоздатьВременныйФайл("", "", Истина)

        если не Ключ.Пусто()
            ВременныйФайл.ОткрытьПотокЗаписи().Записать(Ключ)
            ПараметрыПроцесса.Добавить("--config")
            ПараметрыПроцесса.Добавить("core.sshCommand=\"ssh -i %{ВременныйФайл.Путь}\"")
        ;

        возврат ВременныйФайл
    ;

    @Локально
    метод ВыполнитьКомандуСОжиданием(
            ИмяКоманды: Строка,
            ПараметрыКоманды: Массив<Строка>,
            Таймаут: Длительность = 0с,
            Логирование: ILogging.Логирование
        ): Строка
        
        знч ПараметрыСтрокой = Строки.Соединить(ПараметрыКоманды, " ")
        Логирование.ВывестиСообщение("=================================================================")
        Логирование.ВывестиСообщение("\"%ИмяКоманды\" %ПараметрыСтрокой")
        Логирование.ВывестиСообщение("=================================================================")

        пер Процесс = новый ПроцессОс(ИмяКоманды, ПараметрыКоманды)
        Процесс.Запустить()

        пер времяОжидания = 0с
        пер КодВозврата = 0
        
        пока не Процесс.ОжидатьЗавершения(60с) и Процесс.Живой()

            если Таймаут != 0с и Таймаут <= времяОжидания
                пер текстОшибки = "При выполнении команды платформы превышено время ожидания выполнения %Таймаут"
                Процесс.Остановить()
                выбросить новый ИсключениеНедопустимоеСостояние(текстОшибки)
            ;
            времяОжидания += 60с
        ;

        если Процесс.Живой()
            Процесс.Остановить()
        ;

        пер Результат = Процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку()

        Логирование.ВывестиСообщение(Результат)

        КодВозврата = Процесс.ПолучитьКодВозврата()

        если не КодВозврата == 0
            Логирование.ВывестиСообщение("Код возврата: %КодВозврата")
            Логирование.ВывестиСообщение("\н")
            Логирование.ВывестиСообщение(Процесс.ПолучитьПотокОшибок().ПрочитатьКакСтроку())
            выбросить новый ИсключениеНедопустимоеСостояние()
        ;

        возврат Результат
    ;
;