#!/usr/bin/executor

#требуется IIBOperationProperties.sbsl

@Локально
структура ПараметрыОбновленияКонфигурации

    знч Параметры: Множество<Строка> = {
        "Dynamic",
        "Dynamic-",
        "Dynamic+",
        "WarningsAsErrors",
        "Server",
        "v1",
        "v2",
        "SessionTerminate" // disable, force
    }

;

@Локально
структура НастройкаПроверкиКонфигурации

    знч Проверки: Множество<Строка> = {
        "ThinClient",
        "WebClient",
        "MobileClient",
        "MobileClientStandalone",
        "Server",
        "ExternalConnection",
        "ExternalConnectionServer",
        "MobileAppClient",
        "MobileAppServer",
        "ThickClientManagedApplication",
        "ThickClientServerManagedApplication",
        "ThickClientOrdinaryApplication",
        "ThickClientServerOrdinaryApplication",
        "ConfigLogIntegrity",
        "IncorrectReferences",
        "DistributiveModules",
        "UnreferenceProcedures",
        "HandlersExistence",
        "EmptyHandlers",
        "ExtendedModulesCheck",
        "CheckUseModality",
        "CheckUseSynchronousCalls",
        "UnsupportedFunctional",
        "MobileClientDigiSign "
    }

;

@Локально
структура НастройкаПроверкиМодулей

    знч Проверки: Множество<Строка> = {
        "ThinClient",
        "WebClient",
        "MobileClient",
        "MobileClientStandalone",
        "Server",
        "ExternalConnection",
        "MobileAppClient",
        "MobileAppServer",
        "ThickClientOrdinaryApplication",
        "ExtendedModulesCheck"
    }

;

// ПрограммныйИнтерфейс

@Глобально
метод СоздатьИнформационнуюБазу(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("CREATEINFOBASE")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("", ПараметрыСоединения.СтрокаСоединения)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("ИБ успешно создана")
;

@Глобально
метод ПолучитьСписокРасширений(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ
    ): Строка

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpDBCfgList")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-AllExtensions")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    знч Результат = Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Список расширений успешно получен")

    возврат Результат
;

@Глобально
метод ЗагрузитьКонфигурацию(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуСборки: Строка, ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/LoadCfg", "\"%ПутьКФайлуСборки\"")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Файл успешно загружен: %ПутьКФайлуСборки")
;

@Глобально
метод ЗагрузитьФайлыКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайламПроекта: Строка, ИмяРасширения = "", ПутьКФайлуЗагрузки = "", ОбновитьФайлВерсий = Истина
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/LoadConfigFromFiles")
    если ПутьКФайламПроекта.ЗаканчиваетсяНа(".zip")
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Archive")
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("", "\"%ПутьКФайламПроекта\"")
    если ОбновитьФайлВерсий
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-updateConfigDumpInfo")
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    если не ПутьКФайлуЗагрузки.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-listFile", "\"%ПутьКФайлуЗагрузки\"")
        // Способ указания файлов в командной строке
        // Исполнитель.ДобавитьКлючВыполненияПрограммы("-files")
        // знч ФайлыЗагрузки = новый Файл(ПутьКФайлуЗагрузки).ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        // знч ФайлыЗагрузкиСтрокой = "\"%{ФайлыЗагрузки.Разделить(Символы.НОВАЯ_СТРОКА).Соединить(",")}\""
        // Исполнитель.ДобавитьКлючВыполненияПрограммы(ФайлыЗагрузкиСтрокой)
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-NoCheck")
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("XML файлы успешно загружены в ИБ")
;

@Глобально
метод ВыгрузитьКонфигурацию(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ПутьКФайлуСборки: Строка,  ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpCfg", "\"%ПутьКФайлуСборки\"")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Файл успешно создан: %ПутьКФайлуСборки")
;

@Глобально
метод ВыгрузитьФайлыКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ПутьКФайламПроекта: Строка, ИмяРасширения = "", ТолькоDumpConfig = Ложь, ПутьКФайлуВыгрузки = "", ПутьКФайлуВерсии = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpConfigToFiles", "\"%ПутьКФайламПроекта\"")
    если ТолькоDumpConfig
        // Для расширений использование параметра configDumpInfoOnly вызывает ошибку, поэтому выгружаем все
        если ИмяРасширения.Пусто()
            Исполнитель.ДобавитьКлючВыполненияПрограммы("-configDumpInfoOnly")
        ;
    иначе
        если не ПутьКФайлуВыгрузки.Пусто()
            Исполнитель.ДобавитьКлючВыполненияПрограммы("-listFile", "\"%ПутьКФайлуВыгрузки\"")
        ;
        если не ПутьКФайлуВерсии.Пусто()
            Исполнитель.ДобавитьКлючВыполненияПрограммы("-update")
            Исполнитель.ДобавитьКлючВыполненияПрограммы("-configDumpInfoForChanges", "\"%ПутьКФайлуВерсии\"")
        ;
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("XML файлы успешно выгружены: %ПутьКФайламПроекта")
;

@Глобально
метод ОбновитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыОбновления: Массив<Строка>, ИмяРасширения = ""
    )

    знч ПараметрыОбновленияКонфигурации = новый ПараметрыОбновленияКонфигурации()

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/UpdateDBCfg")
    для ПараметрОбновления из ПараметрыОбновления
        знч ИмяПараметра = ПараметрОбновления.Разделить(" ")[0]
        если не ПараметрыОбновленияКонфигурации.Параметры.Содержит(ИмяПараметра)
            продолжить
        ;
        если не ИмяРасширения.Пусто() и ИмяПараметра == "Server"
            продолжить
        ;
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-%{ПараметрОбновления}")
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Информационная база успешно обновлена")
;

@Глобально
метод ВыгрузитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуВыгрузки = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpIB", ПутьКФайлуВыгрузки.Пусто() ? ПараметрыСоединения.ПолучитьПутьКФайлуВыгрузки() : ПутьКФайлуВыгрузки)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Информационная база успешно обновлена")
;

@Глобально
метод ЗагрузитьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуВыгрузки = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/RestoreIB", ПутьКФайлуВыгрузки)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-JobsCount", "4")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Информационная база успешно обновлена")
;

@Глобально
метод ОчиститьИнформационнуюБазу(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/EraseData ")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Информационная база успешно обновлена")
;

@Глобально
метод ПолучитьСтатусКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ПутьКФайлуСтатуса: Строка, ИмяРасширения = "", ПутьКФайлуВерсии = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpConfigToFiles", "\"\"") // Для избежания ошибки необходимо поставить пустую строку для пути выгрузки
    если не ПутьКФайлуВерсии.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-configDumpInfoForChanges", "\"%ПутьКФайлуВерсии\"")
    ;
    если не ПутьКФайлуВерсии.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-getChanges", "\"%ПутьКФайлуСтатуса\"")
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Статус конфигурации успешно получен: %ПутьКФайлуСтатуса")
;

@Глобально
метод СнятьКонфигурациюСПоддержки(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ManageCfgSupport")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-disableSupport")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-force")
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Конфигурация снята с поддержки")
;

@Глобально
метод ВыполнитьПроверкуМодулей(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ИмяРасширения = "", Проверки: Множество<Строка>
    )

    знч НастройкаПроверкиМодулей = новый НастройкаПроверкиМодулей()
    знч РазрешенныеПроверки = НастройкаПроверкиМодулей.Проверки.Пересечение(Проверки)

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/CheckModules")
    для Проверка из РазрешенныеПроверки
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-%{Проверка}")
    ;
    если ИмяРасширения == "AllExtensions"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-AllExtensions")
    иначе если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Проверка модулей конфигурации завершена")

;

@Глобально
метод ВыполнитьПроверкуКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ИмяРасширения = "", Проверки: Множество<Строка>
    )

    знч НастройкаПроверкиКонфигурации = новый НастройкаПроверкиКонфигурации()
    знч НастройкаПроверкиМодулей = новый НастройкаПроверкиМодулей()
    знч РазрешенныеПроверки = НастройкаПроверкиКонфигурации.Проверки.Пересечение(Проверки)

    если РазрешенныеПроверки.Размер() == 0
        Консоль.Записать("Не указаны параметры проверки")
        возврат
    ;

    если Проверки.Разность(НастройкаПроверкиМодулей.Проверки).Размер() == 0
        ВыполнитьПроверкуМодулей(
            ПараметрыСоединения,
            ИмяРасширения,
            Проверки
        )
        возврат
    ;

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/CheckConfig")
    для Проверка из РазрешенныеПроверки
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-%{Проверка}")
    ;
    если ИмяРасширения == "AllExtensions"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-AllExtensions")
    иначе если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Проверка конфигурации завершена")

;

@Глобально
метод ВыполнитьПроверкуПримененияРасширений(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/CheckCanApplyConfigurationExtensions")
    если не ИмяРасширения.Пусто() и не ИмяРасширения == "AllExtensions"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Проверка применения расширений завершена")

;

@Глобально
метод ВыполнитьТестированиеИсправление(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ВидыТестирования: Массив<Строка>
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/IBCheckAndRepair")
    для ВидТестирования из ВидыТестирования
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-%{ВидТестирования}")
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Тестирование и исправление завершено")
;

@Глобально
метод СравнитьКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПутьКФайлуОтчета: Строка, ПерваяКонфигурация = "MainConfiguration", ВтораяКонфигурация = "DBConfiguration",
        ИмяКонфигурацииПоставщика = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/CompareCfg")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-FirstConfigurationType",  ПерваяКонфигурация)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-SecondConfigurationType", ВтораяКонфигурация)
    если не ИмяКонфигурацииПоставщика.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-SecondName", ИмяКонфигурацииПоставщика)
    ;
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-ReportType", "Full")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-IncludeChangedObjects")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-IncludeDeletedObjects")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-IncludeAddedObjects")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-ReportFormat", "mxl")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-ReportFile", ПутьКФайлуОтчета)
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Файл сравнение основной конфигурации и конфигурации БД успешно получен")
;

@Глобально
метод ПодключитьсяКХранилищуКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryBindCfg")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-forceBindAlreadyBindedUser")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-forceReplaceCfg")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Подключение к хранилищу выполнено")
;

@Глобально
метод ОтключитьсяОтХранилищаКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryUnbindCfg")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-force")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Отключение от хранилища выполнено")
;

@Глобально
метод ПолучитьОтчетПоХранилищуКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ПутьКФайлуОтчета: Строка, ИмяРасширения = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryReport", "\"%ПутьКФайлуОтчета\"")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-NBegin",       "-1")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-ReportFormat", "txt")
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Отчет хранилища конфигурации получен")
;

@Глобально
метод ВыгрузитьКонфигурациюХранилищаКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ПутьКФайлуКонфигурации: Строка, ИмяРасширения = "", Версия: Строка
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryDumpCfg", "\"%ПутьКФайлуКонфигурации\"")
    если не Версия.Пусто() или Версия == "-1"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-v", Версия)
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Конфигурация из хранилища выгружена")
;

@Глобально
метод ПолучитьИзмененияИзХранилищаКонфигурации(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища,
        ИмяРасширения = "", Версия: Строка
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("DESIGNER")
    ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища, Исполнитель)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryUpdateCfg")
    Исполнитель.ДобавитьКлючВыполненияПрограммы("-force")
    если не Версия.Пусто() или Версия == "-1"
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-v", Версия)
    ;
    если не ИмяРасширения.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("-Extension", ИмяРасширения)
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("ИЗменения из хранилища конфигурации получены")
;

@Глобально
метод ЗапуститьВРежимеПредприятия(
        ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ,
        СтрокаЗапуска = "",
        РежимМенеджераТестирования = Ложь,
        ПутьКОбработке = ""
    )

    знч Исполнитель = ИнициализироватьИсполнитель(ПараметрыСоединения)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("ENTERPRISE")
    если РежимМенеджераТестирования
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/TestManager")
    ;
    если не ПутьКОбработке.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/Execute", ПутьКОбработке)
    ;
    если не СтрокаЗапуска.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/C%{СтрокаЗапуска}")
    ;
    ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения, Исполнитель)

    Исполнитель.ВыполнитьКомандуПлатформыСОжиданием()

    Консоль.Записать("Запуск в режиме предприятия завершен")
;

// СлужебныеПроцедурыИФункции

@Локально
метод ДобавитьПараметрыСоединенияИБ(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ, Исполнитель: oc_main.Исполнитель)

    Исполнитель.ДобавитьКлючВыполненияПрограммы("/IBConnectionString", ПараметрыСоединения.СтрокаСоединения)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DisableStartupDialogs", Неопределено)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/WA-", Неопределено)
    если не ПараметрыСоединения.Логин.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/N", "\"%{ПараметрыСоединения.Логин}\"")
    ;
    если не ПараметрыСоединения.Пароль.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/P", "\"%{ПараметрыСоединения.Пароль}\"")
    ;

    Исполнитель.ДобавитьКлючВыполненияПрограммы("/Out",        Исполнитель.Инструкции.Последний().ФайлВывода.Путь)
    Исполнитель.ДобавитьКлючВыполненияПрограммы("/DumpResult", Исполнитель.Инструкции.Последний().ФайлКодаВозврата.Путь)

;

@Локально
метод ДобавитьПараметрыСоединенияСХранилищем(ПараметрыСоединенияХранилища: IIBOperationProperties.ПараметрыСоединенияХранилища, Исполнитель: oc_main.Исполнитель)

    если ПараметрыСоединенияХранилища.Путь.Пусто()
        возврат
    ;

    Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryF", "\"%{ПараметрыСоединенияХранилища.Путь}\"")
    если не ПараметрыСоединенияХранилища.Логин.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryN", "\"%{ПараметрыСоединенияХранилища.Логин}\"")
    ;
    если не ПараметрыСоединенияХранилища.Пароль.Пусто()
        Исполнитель.ДобавитьКлючВыполненияПрограммы("/ConfigurationRepositoryP", "\"%{ПараметрыСоединенияХранилища.Пароль}\"")
    ;

;

@Локально
метод ИнициализироватьИсполнитель(ПараметрыСоединения: IIBOperationProperties.ПараметрыСоединенияИБ): oc_main.Исполнитель

    знч Исполнитель = новый oc_main.Исполнитель()
    Исполнитель.ДобавитьВыполняемуюПрограмму(ПараметрыСоединения.Платформа.Предприятие.Путь)
    Исполнитель.Инструкции.Последний().ФайлВывода       =  Файлы.СоздатьВременныйФайл()
    Исполнитель.Инструкции.Последний().ФайлКодаВозврата =  Файлы.СоздатьВременныйФайл()

    возврат Исполнитель

;