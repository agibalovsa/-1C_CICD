#!/usr/bin/executor

#требуется lib/IConfiguration.sbsl
#требуется lib/IProjectProperties.sbsl
#требуется lib/IProject.sbsl
#требуется lib/IIBOperation.sbsl
#требуется lib/oc_main.sbsl
#требуется lib/IMcpServer.sbsl
#требуется lib/ILogging.sbsl

метод Скрипт(Режимы = "", ПутьДоРепозитория = "", Пауза = 0, ПутьКНастройкам = "", ИменаИБ = "")

    если ПутьДоРепозитория.Пусто()
        если Пауза > 0
            Консоль.СчитатьСтроку("Не задан путь до репозитория. Нажмите Enter...")
        ;
        выбросить новый ИсключениеНедопустимоеСостояние()
    ;

    ПутьДоРепозитория  = oc_main.ИсправитьРазделителиПути(ПутьДоРепозитория)
    ПутьКНастройкам    = oc_main.ИсправитьРазделителиПути(ПутьКНастройкам)

    знч СтатусВыполнения = ВыполнитьКомандуРежима(Режимы, ПутьДоРепозитория, ПутьКНастройкам, ИменаИБ)

    если СтатусВыполнения
        если Режимы == "init" и Пауза > 0
            Консоль.СчитатьСтроку("\нИнициализация закончена. Нажмите Enter...")
        иначе если Пауза > 0
            Консоль.СчитатьСтроку("\нКонвертация закончена. Нажмите Enter...")
        иначе
            Консоль.Записать("\нКонвертация закончена")
        ;
    иначе
        если Пауза > 0
            Консоль.СчитатьСтроку("\нОшибка выполнения. Нажмите Enter...")
        иначе
            Консоль.Записать("\нОшибка выполнения")
        ;
        выбросить новый ИсключениеНедопустимоеСостояние()
    ;

;

метод ВыполнитьКомандуРежима(Режимы = "", ПутьДоРепозитория = "", ПутьКНастройкам = "", ИменаИБ = "", МетодЛогирования: ((Строка)->ничто)? = Неопределено): Булево

    пер СтатусВыполнения = Ложь

    знч РабочийКаталог = Скрипт.ПолучитьРабочийКаталог()

    если oc_main.ЭтоАбсолютныйПуть(ПутьДоРепозитория)
        Скрипт.УстановитьРабочийКаталог(ПутьДоРепозитория)
    иначе
        Скрипт.УстановитьРабочийКаталог(oc_main.ДобавитьЧастьПути(РабочийКаталог, [ПутьДоРепозитория]))
    ;

    пер ПараметрыПроекта: IProjectProperties.ПараметрыПроекта?
    пер Логирование = новый ILogging.Логирование()
    Логирование.Инициализировать(МетодЛогирования)

    попытка

        ПараметрыПроекта = IProjectProperties.ПараметрыПроекта.Инициализировать(
            ПутьКНастройкам,
            ИменаИБ.Разделить(","),
            Режимы.Содержит('_ib[ ,_]?'),
            Логирование
        )

        для Режим из Режимы.Разделить(",")

            выбор Режим.ВНижнийРегистр()
            когда "init"
                ИнициализироватьСкриптыВыполнения(ПараметрыПроекта, ПутьДоРепозитория, ПутьКНастройкам)
                ИнициализироватьGitPrecommit(ПараметрыПроекта, ПутьКНастройкам)
                СтатусВыполнения = Истина
            когда "platform_test"
                СтатусВыполнения = IProject.ВыполнитьТестированиеПлатформы(ПараметрыПроекта, 100)
            когда "check_bin"
                СтатусВыполнения = IProject.АнализироватьНастройкиПоддержки(ПараметрыПроекта)
            когда "repair_bin"
                СтатусВыполнения = IProject.АнализироватьНастройкиПоддержки(ПараметрыПроекта, Истина)
            когда "check_bin_prod"
                СтатусВыполнения = IProject.АнализироватьНастройкиПоддержкиКонфигурацииПоставщика(ПараметрыПроекта)
            когда "repair_bin_prod"
                СтатусВыполнения = IProject.АнализироватьНастройкиПоддержкиКонфигурацииПоставщика(ПараметрыПроекта, Истина)
            когда "new_bin"
                знч ОсновнаяКонфигурация = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
                ОсновнаяКонфигурация.СтруктураКонфигурации.ПеревестиВНовыйФорматParentConfigurations()
                СтатусВыполнения = Истина
            когда "new_configdumpinfo"
                знч ОсновнаяКонфигурация = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
                ОсновнаяКонфигурация.СтруктураКонфигурации.ПеревестиВНовыйФорматConfigDumpInfo()
                СтатусВыполнения = Истина
                для Расширение из ПараметрыПроекта.ПолучитьРасширения()
                    Расширение.СтруктураКонфигурации.ПеревестиВНовыйФорматConfigDumpInfo()
                ;
            когда "check_ib_cf"
                СтатусВыполнения = IProject.ВыполнитьПроверкуКонфигурации(ПараметрыПроекта)
            когда "check_ib_cfe"
                СтатусВыполнения = IProject.ВыполнитьПроверкуКонфигурации(ПараметрыПроекта, Истина)
            когда "check_ib"
                СтатусВыполнения = IProject.ВыполнитьТестированиеИсправление(ПараметрыПроекта)
            когда "get_ib_configdumpinfo"
                знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьОсновнуюИнформационнуюБазу()
                СтатусВыполнения = IProject.ПолучитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза, "ConfigDumpInfo.xml")
            когда "get_prod_configdumpinfo"
                СтатусВыполнения = IProject.ПолучитьФайлыКонфигурацииПоставщика(ПараметрыПроекта, "ConfigDumpInfo.xml")
            когда "get_ib_status"
                СтатусВыполнения = IProject.ПолучитьСтатусКонфигурации(ПараметрыПроекта)
            когда "get_ib_xml"
                знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьОсновнуюИнформационнуюБазу()
                СтатусВыполнения = IProject.ПолучитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
            когда "get_ib_xml_cfe"
                СтатусВыполнения = Истина
                для Расширение из ПараметрыПроекта.ПолучитьРасширения()
                    знч ИнформационнаяБаза = ПараметрыПроекта.ПолучитьИнформационнуюБазуКонфигурации(Расширение)
                    СтатусВыполнения = СтатусВыполнения и IProject.ПолучитьФайлыКонфигурации(ПараметрыПроекта, ИнформационнаяБаза)
                ;
            когда "get_prod_xml"
                СтатусВыполнения = IProject.ПолучитьФайлыКонфигурацииПоставщика(ПараметрыПроекта)
            когда "update_ib"
                СтатусВыполнения = IProject.ОбновитьИнформационнуюБазу(ПараметрыПроекта)
            когда "update_ib_cf"
                СтатусВыполнения = IProject.ОбновитьКонфигурацию(ПараметрыПроекта, 1)
            когда "update_ib_cf_xml"
                СтатусВыполнения = IProject.ОбновитьКонфигурацию(ПараметрыПроекта, 2)
            когда "update_ib_cfe"
                СтатусВыполнения = IProject.ОбновитьКонфигурацию(ПараметрыПроекта, 3)
            когда "update_ib_cfe_xml"
                СтатусВыполнения = IProject.ОбновитьКонфигурацию(ПараметрыПроекта, 4)
            когда "update_ib_patch"
                СтатусВыполнения = IProject.ОбновитьКонфигурацию(ПараметрыПроекта, 5)
            когда "archive_ib"
                СтатусВыполнения = IProject.ВыгрузитьИнформационнуюБазу(ПараметрыПроекта)
            когда "replicate_ib"
                СтатусВыполнения = IProject.СкопироватьИнформационнуюБазу(ПараметрыПроекта)
            когда "build_cf"
                СтатусВыполнения = IProject.СобратьКонфигурацию(ПараметрыПроекта)
            когда "build_cfe"
                СтатусВыполнения = IProject.СобратьКонфигурацию(ПараметрыПроекта, Истина)
            когда "build_patch"
                СтатусВыполнения = IProject.СобратьПатчКонфигурации(ПараметрыПроекта)
            когда "build_prod"
                СтатусВыполнения = IProject.СобратьКонфигурацию(ПараметрыПроекта, Ложь, Истина)
            когда "git_sync_xml"
                СтатусВыполнения = IProject.СинхронизироватьХранилищеКонфигурацийСGitХранилищем(ПараметрыПроекта)
            когда "git_commit_ib_xml"
                СтатусВыполнения = IProject.ПоместитьИзмененияКонфигурацийВGitХранилище(ПараметрыПроекта)
            когда "mcp"
                
                знч McpServer = новый IMcpServer.McpServer(
                    КонтекстИсполненияПроекта = ПараметрыПроекта.КонтекстИсполнения
                )
                McpServer.Инициализировать(
                    (Действие: Строка, ПутьРепозитория: Строка, КлючБазы: Строка)
                        -> ВыполнитьКомандуРежима(Режимы = Действие, ПутьДоРепозитория = ПутьРепозитория, ИменаИБ = КлючБазы)
                )
                McpServer.Запустить()
                
            иначе
                ПараметрыПроекта.Логирование.ВывестиСообщение("Неизвестный режим запуска %Режим\н")
                прервать
            ;
        ;

    поймать Исключение: Исключение
        если не Исключение.Описание.Пусто()
            Логирование.ВывестиСообщение("\н#################################################################")
            Логирование.ВывестиСообщение(Исключение.Информация())
            Логирование.ВывестиСообщение("#################################################################")
        ;
    ;

    если не ПараметрыПроекта == Неопределено
        ПараметрыПроекта.ЗаписатьПользовательскиеНастройки()
    ;

    возврат СтатусВыполнения

;

метод ИнициализироватьСкриптыВыполнения(ПараметрыПроекта: IProjectProperties.ПараметрыПроекта, ПутьДоРепозитория: Строка, ПутьКНастройкам: Строка)

    знч используемаяОС = oc_main.ИспользуемаяОС()

    пер Расширение = ""
    пер Шебанг = ""
    выбор используемаяОС
    когда oc_main.ОперационныеСистемы.Windows
        Расширение = "bat"
    когда oc_main.ОперационныеСистемы.Linux
        Расширение = "sh"
        Шебанг = "#!/usr/bin/bash\н"
    ;

    знч КомандыЗапуска = oc_main.ПолучитьКомандыЗапуска()

    пер ПутьКСкриптуИсполненияПараметр = ПараметрыПроекта.Платформа.ПутьКСкриптуИсполнения.ОтносительныйПуть
    если не oc_main.ЭтоАбсолютныйПуть(ПутьКСкриптуИсполненияПараметр)
        ПутьКСкриптуИсполненияПараметр = oc_main.ДобавитьЧастьПути(ПутьДоРепозитория, [ПутьКСкриптуИсполненияПараметр])
    ;

    знч СР = Файлы.СимволРазделителя
    знч ПутьДоРепозиторияПараметр = "\"" + ((СР == "\\") ? ПутьДоРепозитория.Заменить(СР, "\\\\") : ПутьДоРепозитория) + "\""
    знч ПутьКНастройкамПараметр = ПутьКНастройкам.Пусто()
        ? ""
        : "\"" + ((СР == "\\") ? ПутьКНастройкам.Заменить(СР, "\\\\") : ПутьКНастройкам) + "\""

    для Команда из КомандыЗапуска

        выбор используемаяОС
        когда oc_main.ОперационныеСистемы.Windows
            Расширение = "bat"
            знч ФайлСкрипта = новый Файл(oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКСборкеПроекта.ФайлыПроекта.Путь, ["%{Команда}.%{Расширение}"]))
            ФайлСкрипта.ОткрытьПотокЗаписи(Ложь)
                .Записать("executor \"%{ПутьКСкриптуИсполненияПараметр}\" -Режимы %{Команда} -ПутьДоРепозитория %{ПутьДоРепозиторияПараметр} -Пауза 1 %{ПутьКНастройкамПараметр .Пусто() ? "" : "-ПутьКНастройкам " + ПутьКНастройкамПараметр}", Кодировка.Cp866).Закрыть()
        когда oc_main.ОперационныеСистемы.Linux
            Расширение = "sh"
            Шебанг = "#!/usr/bin/bash\н"
            знч ФайлСкрипта = новый Файл(oc_main.ДобавитьЧастьПути(ПараметрыПроекта.КонтекстИсполнения.ПутьКСборкеПроекта.ФайлыПроекта.Путь, ["%{Команда}.%{Расширение}"]))
            ФайлСкрипта.ОткрытьПотокЗаписи(Ложь)
                .Записать(Шебанг)
                .Записать("executor \"%{ПутьКСкриптуИсполненияПараметр}\" -Режимы \"%{Команда}\" -ПутьДоРепозитория \"%{ПутьДоРепозиторияПараметр}\" -Пауза 1 %{ПутьКНастройкамПараметр .Пусто() ? "" : "-ПутьКНастройкам \"" + ПутьКНастройкамПараметр + "\""}").Закрыть()
        ;

    ;

;

метод ИнициализироватьGitPrecommit(
    ПараметрыПроекта: IProjectProperties.ПараметрыПроекта,
    ПутьКНастройкам:  Строка
)

    если ПараметрыПроекта.РаботаТолькоСХранилищем()
        возврат
    ;

    знч КаталогHooks = новый Файл(oc_main.ДобавитьЧастьПути(".git", ["hooks"]))
    если не КаталогHooks.Существует()
        ПараметрыПроекта.Логирование.ВывестиСообщение("\н#################################################################")
        ПараметрыПроекта.Логирование.ВывестиСообщение("Не найдены системные файлы git репозитория \"${КаталогHooks.Путь}\"")
        ПараметрыПроекта.Логирование.ВывестиСообщение("#################################################################")
        возврат
    ;

    знч СР = Файлы.СимволРазделителя
    знч СРLinux = "/"

    знч ПутьКСкриптуИсполненияПараметр = "\"" + ПараметрыПроекта.Платформа.ПутьКСкриптуИсполнения.ОтносительныйПуть.Заменить(СР, СРLinux) + "\""
    знч ПутьКНастройкамПараметр = ПутьКНастройкам.Пусто()
        ? ""
        : "\"" + ПутьКНастройкам.Заменить(СР, СРLinux) + "\""

    знч ОсновнаяКонфигурация = ПараметрыПроекта.ПолучитьОсновнуюКонфигурацию()
    знч ФайлConfigDumpInfo = ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьФайлConfigDumpInfo()
    знч ОтносительныйПутьConfigDumpInfo =
        ФайлConfigDumpInfo.Существует()
        ? oc_main.УдалитьЧастьПути(ФайлConfigDumpInfo.Путь, [ПараметрыПроекта.КонтекстИсполнения.РабочийКаталог]).Заменить(СР, СРLinux)
        : ""
    знч ФайлParentConfigurations = ОсновнаяКонфигурация.СтруктураКонфигурации.ПолучитьФайлParentConfigurations()
    знч ОтносительныйПутьParentConfigurations = 
        ФайлParentConfigurations.Существует()
        ? oc_main.УдалитьЧастьПути(ФайлParentConfigurations.Путь, [ПараметрыПроекта.КонтекстИсполнения.РабочийКаталог]).Заменить(СР, СРLinux)
        : ""
    пер ОтносительныйПутьConfigDumpInfoРасширений = ""
    для Расширение из ПараметрыПроекта.ПолучитьРасширения()
        ОтносительныйПутьConfigDumpInfoРасширений = Расширение.СтруктураКонфигурации.ПолучитьОтносительныйПутьКФайламКонфигурации()
        ОтносительныйПутьConfigDumpInfoРасширений = oc_main.ДобавитьЧастьПути(
             ОтносительныйПутьConfigDumpInfoРасширений.Заменить(Расширение.СтруктураКонфигурации.ПолучитьИмяКонфигурации(), "*"),
             [ФайлConfigDumpInfo.Имя]).Заменить(СР, СРLinux)
        прервать
    ;

    знч СтрокаАвтоФиксации =
        [
            ОтносительныйПутьParentConfigurations,
            ОтносительныйПутьConfigDumpInfo,
            ОтносительныйПутьConfigDumpInfoРасширений
        ]
    СтрокаАвтоФиксации.Удалить("")
    знч СтрокаАвтоСборки  =
        [
            ОтносительныйПутьParentConfigurations.Пусто()     ? "" : "new_bin",
            ОтносительныйПутьConfigDumpInfo.Пусто()           ? "" : "new_configdumpinfo",
            ОтносительныйПутьConfigDumpInfoРасширений.Пусто() ? "" : "build_cfe"
        ]
    СтрокаАвтоСборки.Удалить("")
    если СтрокаАвтоФиксации.Размер() == 0
        возврат
    ;
    знч ТекстPrecommit =
        [
            "#!/bin/sh",
            "executor %{ПутьКСкриптуИсполненияПараметр} -Режимы \"%{СтрокаАвтоСборки.Соединить(",")}\" -ПутьДоРепозитория \".\" -Пауза 0 -ПутьКНастройкам \"%{ПутьКНастройкамПараметр}\"",
            "git add %{СтрокаАвтоФиксации.Соединить(" ")}"
        ]

    знч ФайлPrecommit = новый Файл(oc_main.ДобавитьЧастьПути(".git", ["hooks", "pre-commit"]))
    если ФайлPrecommit.Существует()
        ПараметрыПроекта.Логирование.ВывестиСообщение("\н#################################################################")
        ПараметрыПроекта.Логирование.ВывестиСообщение("Файл \"%{ФайлPrecommit.Путь}\" существует. Необходимо внести в него следующие строки:")
        ПараметрыПроекта.Логирование.ВывестиСообщение("\н")
        ПараметрыПроекта.Логирование.ВывестиСообщение(ТекстPrecommit.Соединить("\н"))
        ПараметрыПроекта.Логирование.ВывестиСообщение("\н")
        ПараметрыПроекта.Логирование.ВывестиСообщение("#################################################################")

        возврат
    ;

    ФайлPrecommit.ОткрытьПотокЗаписи().Записать(ТекстPrecommit.Соединить("\н")).Закрыть()

;